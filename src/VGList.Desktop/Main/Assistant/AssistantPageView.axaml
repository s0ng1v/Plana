<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VGList.Desktop.Main.Assistant"
             xmlns:c="using:VGList.Desktop.Controls"
             xmlns:svc="using:VGList.Desktop.Services"
             x:Class="VGList.Desktop.Main.Assistant.AssistantPageView"
             x:DataType="vm:AssistantPageViewModel"
             FontFamily="{DynamicResource Font.Ui}"
             DragDrop.AllowDrop="True">

  <UserControl.Styles>
    <!-- 左侧会话条目 -->
    <Style Selector="Border.chat-session-item">
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="8,1" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.chat-session-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
    </Style>
    <Style Selector="Border.chat-session-item.selected">
      <Setter Property="Background" Value="{DynamicResource Main.Selected}" />
    </Style>
    <Style Selector="Border.session-del-btn">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.chat-session-item:pointerover Border.session-del-btn">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.session-del-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Danger.Soft}" />
    </Style>

    <!-- 顶部模型选择下拉胶囊 -->
    <Style Selector="Border.model-pill">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0,12,0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Main.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.model-pill:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent.Border}" />
    </Style>
    <Style Selector="Border.model-pill.open">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent}" />
    </Style>

    <!-- 下拉菜单行（模型选择 & @ 文件引用共用风格） -->
    <Style Selector="Border.dropdown-row">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dropdown-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
    </Style>
    <Style Selector="Border.dropdown-row.selected">
      <Setter Property="Background" Value="{DynamicResource Main.Selected}" />
    </Style>

    <!-- 历史助理回复的静影 Lana（活体 Lana 移向新一轮时，原位置柔和淡入零帧开销静态小头像） -->
    <Style Selector="c|LanaAvatarControl.past-lana-avatar">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.28" Delay="0:0:0.08" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="c|LanaAvatarControl.past-lana-avatar.echo">
      <Setter Property="Opacity" Value="0.82" />
    </Style>
    <Style Selector=":is(UserControl).no-motion c|LanaAvatarControl.past-lana-avatar">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <!-- 用户消息悬停浮现铅笔编辑栏 -->
    <Style Selector="StackPanel.user-msg-actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.user-msg-wrap:pointerover StackPanel.user-msg-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- 底部浮动胶囊输入框 & 行内编辑卡 -->
    <Style Selector="Border.chat-composer">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{DynamicResource Assistant.Composer.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Assistant.Composer.Border}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BoxShadow" Value="{DynamicResource Main.Popup.Shadow}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.chat-composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Assistant.Composer.FocusBorder}" />
    </Style>

    <!-- 发送 / 停止圆形按钮 -->
    <Style Selector="Border.send-circle">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource Main.Accent}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.send-circle:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Accent.Hover}" />
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Border.send-circle.disabled">
      <Setter Property="Opacity" Value="0.32" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Border.stop-circle">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource Main.Text.Primary}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.stop-circle:pointerover">
      <Setter Property="Opacity" Value="0.88" />
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>

    <!-- 柔和强调按钮 -->
    <Style Selector="Border.chat-btn-soft">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Main.Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.chat-btn-soft:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent}" />
    </Style>

    <!-- 助理主按钮 -->
    <Style Selector="Border.chat-btn-primary">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Main.Accent}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.chat-btn-primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Accent.Hover}" />
    </Style>
    <Style Selector="Border.chat-btn-primary.disabled">
      <Setter Property="Opacity" Value="0.38" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 助理次按钮 -->
    <Style Selector="Border.chat-btn-ghost">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Main.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.chat-btn-ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent.Border}" />
    </Style>

    <!-- 回到底部悬浮胶囊 -->
    <Style Selector="Border.scroll-pill">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Main.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource Main.Card.Shadow}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.scroll-pill:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent.Border}" />
    </Style>

    <!-- 提案条目行 -->
    <Style Selector="Border.prop-row">
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.prop-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
    </Style>
    <Style Selector="Border.prop-row.dimmed">
      <Setter Property="Opacity" Value="0.52" />
    </Style>
    <Style Selector="Border.prop-row.locked">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Border.prop-row.locked:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBlock.undone-title">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="{DynamicResource Main.Text.Tertiary}" />
    </Style>

    <!-- 单条撤销轻按钮 -->
    <Style Selector="Border.item-undo-btn">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource Main.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.item-undo-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent.Border}" />
    </Style>

    <!-- 提案条目内的差异化圆角标签（日期 / 优先级 / 附加信息） -->
    <Style Selector="Border.prop-pill">
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.prop-pill.date">
      <Setter Property="Background" Value="{DynamicResource Proposal.Pill.Date.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Proposal.Pill.Date.Border}" />
    </Style>
    <Style Selector="Border.prop-pill.date TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Proposal.Pill.Date.Fg}" />
    </Style>
    <Style Selector="Border.prop-pill.prio-high">
      <Setter Property="Background" Value="{DynamicResource Main.Eisenhower.High.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Eisenhower.High.Border}" />
    </Style>
    <Style Selector="Border.prop-pill.prio-high TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Priority.High}" />
    </Style>
    <Style Selector="Border.prop-pill.prio-medium">
      <Setter Property="Background" Value="{DynamicResource Main.Eisenhower.Medium.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Eisenhower.Medium.Border}" />
    </Style>
    <Style Selector="Border.prop-pill.prio-medium TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Provider.Warn.Fg}" />
    </Style>
    <Style Selector="Border.prop-pill.prio-low">
      <Setter Property="Background" Value="{DynamicResource Main.Eisenhower.Low.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Eisenhower.Low.Border}" />
    </Style>
    <Style Selector="Border.prop-pill.prio-low TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Priority.Low}" />
    </Style>
    <Style Selector="Border.prop-pill.prio-none">
      <Setter Property="Background" Value="{DynamicResource Main.Eisenhower.None.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Eisenhower.None.Border}" />
    </Style>
    <Style Selector="Border.prop-pill.prio-none TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Main.Text.Secondary}" />
    </Style>
    <Style Selector="Border.prop-pill.meta">
      <Setter Property="Background" Value="{DynamicResource Proposal.Pill.Meta.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Proposal.Pill.Meta.Border}" />
    </Style>
    <Style Selector="Border.prop-pill.meta TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Proposal.Pill.Meta.Fg}" />
    </Style>
    <Style Selector="Border.prop-pill.reminder">
      <Setter Property="Background" Value="{DynamicResource Proposal.Pill.Meta.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Proposal.Pill.Meta.Border}" />
    </Style>
    <Style Selector="Border.prop-pill.reminder TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Main.Text.Secondary}" />
    </Style>
    <Style Selector="Border.prop-pill.reminder-on">
      <Setter Property="Background" Value="{DynamicResource Main.Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent.Border}" />
    </Style>
    <Style Selector="Border.prop-pill.reminder-on TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Main.Accent}" />
    </Style>
    <Style Selector="Border.prop-pill.interactive">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.prop-pill.interactive:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent}" />
    </Style>

    <!-- 文件引用胶囊（圆角浅底 + 彩色类型角标） -->
    <Style Selector="Border.file-ref-pill">
      <Setter Property="Padding" Value="7,4,8,4" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Mention.Pill.Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Mention.Pill.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
          <BrushTransition Property="Background" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.file-ref-pill:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent.Border}" />
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
    </Style>

    <!-- 消息微操作按钮 -->
    <Style Selector="Border.msg-action">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.msg-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
    </Style>

    <!-- 提案动作标签（新增 / 改期 / 修改 / 删除） -->
    <Style Selector="Border.prop-tag">
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.prop-tag.add">
      <Setter Property="Background" Value="{DynamicResource Assistant.Proposal.Add.Bg}" />
    </Style>
    <Style Selector="Border.prop-tag.move">
      <Setter Property="Background" Value="{DynamicResource Assistant.Proposal.Move.Bg}" />
    </Style>
    <Style Selector="Border.prop-tag.edit">
      <Setter Property="Background" Value="{DynamicResource Assistant.Proposal.Edit.Bg}" />
    </Style>
    <Style Selector="Border.prop-tag.delete">
      <Setter Property="Background" Value="{DynamicResource Main.Danger.Soft}" />
    </Style>
    <Style Selector="Border.prop-tag.add TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Assistant.Proposal.Add.Fg}" />
    </Style>
    <Style Selector="Border.prop-tag.move TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Assistant.Proposal.Move.Fg}" />
    </Style>
    <Style Selector="Border.prop-tag.edit TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Assistant.Proposal.Edit.Fg}" />
    </Style>
    <Style Selector="Border.prop-tag.delete TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Main.Danger}" />
    </Style>

    <!-- 提案条目复选框 -->
    <Style Selector="Border.prop-check">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Divider}" />
      <Setter Property="Background" Value="{DynamicResource Main.Bg}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.prop-check.checked">
      <Setter Property="Background" Value="{DynamicResource Main.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*" Background="{DynamicResource Assistant.Canvas.Bg}">

    <!-- ===== 左侧可折叠会话历史栏（236 ↔ 0） ===== -->
    <Border x:Name="HistorySidebar"
            Grid.Column="0"
            Width="236"
            ClipToBounds="True"
            Background="{DynamicResource Assistant.Sidebar.Bg}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Border.Transitions>
      <Grid Width="236" ColumnDefinitions="*,1">
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

          <!-- 顶栏：新对话按钮 -->
          <Grid Grid.Row="0" Margin="12,14,12,10" ColumnDefinitions="*,Auto">
            <TextBlock Text="对话"
                       FontFamily="{DynamicResource Font.Display}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Main.Text.Primary}"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    Classes="chat-btn-soft"
                    PointerPressed="OnNewSessionPressed">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Path Data="M6,1 V11 M1,6 H11"
                      Stroke="{DynamicResource Main.Accent}"
                      StrokeThickness="1.6"
                      StrokeLineCap="Round"
                      Width="12"
                      Height="12"
                      Stretch="None"
                      VerticalAlignment="Center" />
                <TextBlock Text="新对话"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Main.Accent}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- 会话列表 -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,2,0,12">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatSessionItemViewModel">
                  <Border Classes="chat-session-item"
                          Classes.selected="{Binding IsSelected}"
                          PointerPressed="OnSessionItemPressed">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <vm:ToolSpinnerRing Grid.Column="0"
                                          Width="11"
                                          Height="11"
                                          Margin="0,0,6,0"
                                          IsVisible="{Binding IsGenerating}"
                                          VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Title}"
                                 FontSize="13"
                                 Foreground="{DynamicResource Main.Text.Primary}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="2"
                              Classes="session-del-btn"
                              ToolTip.Tip="删除对话"
                              PointerPressed="OnDeleteSessionPressed">
                        <Path Data="M3,3 L9,9 M9,3 L3,9"
                              Stroke="{DynamicResource Main.Text.Secondary}"
                              StrokeThickness="1.3"
                              StrokeLineCap="Round"
                              Width="12"
                              Height="12"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 底部本地隐私徽注 -->
          <Border Grid.Row="2"
                  Margin="12,0,12,14"
                  Padding="10,8"
                  CornerRadius="10"
                  Background="{DynamicResource Main.Bg}"
                  BorderBrush="{DynamicResource Main.Border.Subtle}"
                  BorderThickness="1">
            <TextBlock Text="Lana · 你的日程小助手"
                       FontSize="11.5"
                       Foreground="{DynamicResource Main.Text.Secondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource Main.Divider}" />
      </Grid>
    </Border>

    <!-- ===== 主对话画布 ===== -->
    <Panel Grid.Column="1" x:Name="ChatStageHost">
      <Grid RowDefinitions="52,*,Auto">

        <!-- 顶栏：仅保留折叠按钮 + 模型下拉选择胶囊（极简清爽） -->
        <Border Grid.Row="0"
                Padding="16,0"
                Background="{DynamicResource Assistant.Canvas.Bg}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border Classes="icon-btn"
                    ToolTip.Tip="折叠/展开对话历史"
                    PointerPressed="OnToggleHistoryPressed">
              <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M6.5,3.5 V12.5"
                    Stroke="{DynamicResource Main.Text.Secondary}"
                    StrokeThickness="1.35"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Width="16"
                    Height="16"
                    Stretch="None"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <!-- 当前模型下拉按钮 -->
            <Border Classes="model-pill"
                    Classes.open="{Binding IsModelDropdownOpen}"
                    ToolTip.Tip="点击切换当前使用的模型"
                    PointerPressed="OnModelPillPressed">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Image Width="16"
                       Height="16"
                       Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       Source="{Binding ActiveProviderLogo}"
                       IsVisible="{Binding HasActiveProviderLogo}"
                       VerticalAlignment="Center" />
                <Panel IsVisible="{Binding !HasActiveProviderLogo}" VerticalAlignment="Center">
                  <Ellipse Width="7"
                           Height="7"
                           Fill="{DynamicResource Provider.Badge.Fg}"
                           IsVisible="{Binding HasActiveModel}" />
                  <Ellipse Width="7"
                           Height="7"
                           Fill="{DynamicResource Provider.Warn.Fg}"
                           IsVisible="{Binding !HasActiveModel}" />
                </Panel>
                <TextBlock Text="{Binding ActiveModelLabel}"
                           FontFamily="{DynamicResource Font.Display}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Main.Text.Primary}"
                           VerticalAlignment="Center" />
                <Path Data="M3,5 L6,8 L9,5"
                      Stroke="{DynamicResource Main.Text.Tertiary}"
                      StrokeThickness="1.4"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Width="12"
                      Height="12"
                      Stretch="None"
                      VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 中央内容区：极简欢迎态 / 对话流 + 唯一活体 Lana 舞台层 + 浮动「回到底部」胶囊 -->
        <Panel Grid.Row="1" x:Name="ConversationStage" ClipToBounds="True">

          <!-- A. 空态欢迎主视觉（居中锚位由上方活体 Lana 停靠 + 实时时间问候 + 多变自然副标题） -->
          <Grid x:Name="EmptyStateLayer">
            <StackPanel MaxWidth="580"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="28,0,28,36"
                        Spacing="14">

              <!-- 居中欢迎态 Lana 锚位（固定几何，不参与淡出位移，确保首轮/新对话飞翔坐标精准） -->
              <Border x:Name="HomeLanaAnchor"
                      Width="108"
                      Height="108"
                      HorizontalAlignment="Center"
                      Background="Transparent"
                      IsHitTestVisible="False" />

              <StackPanel x:Name="EmptyStateGreeting" Spacing="14" HorizontalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding GreetingPrefix}"
                               FontFamily="{DynamicResource Font.Display}"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Main.Text.Primary}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,1" />
                    <TextBlock Text="Lana"
                               FontFamily="{DynamicResource Font.Display}"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Lana.NameGradient}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,-0.5" />
                  </StackPanel>

                  <TextBlock Text="{Binding GreetingSubtitle}"
                             FontSize="13.5"
                             LineHeight="22"
                             Foreground="{DynamicResource Main.Text.Secondary}"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />
                </StackPanel>

                <!-- 未配置模型温和引导 -->
                <Border IsVisible="{Binding !HasActiveModel}"
                        CornerRadius="12"
                        Background="{DynamicResource Provider.Warn.Bg}"
                        Padding="14,9"
                        HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="还没有绑定模型 API 哦，去设置里配一个就能和 Lana 畅聊啦"
                               FontSize="12"
                               Foreground="{DynamicResource Provider.Warn.Fg}"
                               VerticalAlignment="Center" />
                    <Border Padding="9,4"
                            CornerRadius="7"
                            Background="{DynamicResource Main.Bg}"
                            Cursor="Hand"
                            PointerPressed="OnOpenModelSettingsPressed">
                      <TextBlock Text="去配置 →"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Main.Accent}" />
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- B. 活跃对话消息流 -->
          <Panel x:Name="ConversationLayer" IsVisible="{Binding HasMessages}">
            <ScrollViewer x:Name="MessageScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="OnMessageScrollChanged">
              <ItemsControl x:Name="MessagesList"
                            ItemsSource="{Binding Messages}"
                            MaxWidth="760"
                            Margin="28,12,28,28">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Panel svc:RevealMotion.Enabled="True"
                           svc:RevealMotion.OffsetY="8"
                           svc:RevealMotion.DurationMs="210"
                           Margin="0,0,0,22">

                      <!-- 用户消息区：正常显示态（悬停浮现铅笔编辑 + 复制） / 行内编辑态（支持文字与图片文件增删改） -->
                      <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right">

                        <!-- 1) 正常显示态 -->
                        <Border Classes="user-msg-wrap"
                                Background="Transparent"
                                IsVisible="{Binding ShowUserDisplayBubble}"
                                HorizontalAlignment="Right"
                                MaxWidth="540">
                          <StackPanel Spacing="6" HorizontalAlignment="Right">
                            <ItemsControl ItemsSource="{Binding Attachments}"
                                          IsVisible="{Binding HasAttachments}"
                                          HorizontalAlignment="Right">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatAttachmentItem">
                                  <Panel Margin="6,0,0,4">
                                    <!-- 图片附件胶囊（悬停弹出清晰缩略图预览） -->
                                    <Border Classes="file-ref-pill" IsVisible="{Binding HasThumbnail}">
                                      <ToolTip.Tip>
                                        <StackPanel Spacing="6" MaxWidth="270">
                                          <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Main.Surface.Subtle}">
                                            <Image Source="{Binding ThumbnailBitmap}"
                                                   MaxWidth="256"
                                                   MaxHeight="180"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                          </Border>
                                          <TextBlock Text="{Binding Name}"
                                                     FontSize="11.5"
                                                     FontWeight="Medium"
                                                     TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                      </ToolTip.Tip>
                                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" CornerRadius="4" ClipToBounds="True">
                                          <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Main.Text.Primary}"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                      </StackPanel>
                                    </Border>

                                    <!-- 文档/非图片附件胶囊 -->
                                    <Border Classes="file-ref-pill"
                                            IsVisible="{Binding !HasThumbnail}"
                                            ToolTip.Tip="{Binding FullPath}">
                                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border MinWidth="18"
                                                Height="18"
                                                Padding="4,0"
                                                CornerRadius="4"
                                                Background="{Binding FileBadgeBrush}"
                                                VerticalAlignment="Center">
                                          <TextBlock Text="{Binding FileBadgeText}"
                                                     FontSize="9.5"
                                                     FontWeight="Bold"
                                                     Foreground="{DynamicResource Text.OnAccent}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Main.Text.Primary}"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                      </StackPanel>
                                    </Border>
                                  </Panel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Padding="14,10"
                                    CornerRadius="18,18,6,18"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource Assistant.UserBubble.Bg}"
                                    BorderBrush="{DynamicResource Assistant.UserBubble.Border}"
                                    BorderThickness="1">
                              <SelectableTextBlock Text="{Binding Text}"
                                                   FontFamily="{DynamicResource Font.Ui}"
                                                   FontSize="14"
                                                   LineHeight="22"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Main.Text.Primary}" />
                            </Border>

                            <!-- 鼠标悬浮在用户消息上时显示的铅笔编辑 & 复制按钮 -->
                            <StackPanel Classes="user-msg-actions"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Right">
                              <Border Classes="msg-action"
                                      ToolTip.Tip="编辑这条消息（支持修改文字与附件并重新生成）"
                                      PointerPressed="OnEditMessagePressed">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                  <Path Data="M9.5,2.2 L11.8,4.5 L4.8,11.5 L2,12 L2.5,9.2 Z"
                                        Stroke="{DynamicResource Main.Text.Secondary}"
                                        StrokeThickness="1.25"
                                        StrokeLineCap="Round"
                                        StrokeJoin="Round"
                                        Width="12"
                                        Height="12"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center" />
                                  <TextBlock Text="编辑"
                                             FontSize="11"
                                             Foreground="{DynamicResource Main.Text.Secondary}"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                              </Border>
                              <Border Classes="msg-action"
                                      ToolTip.Tip="复制内容"
                                      PointerPressed="OnCopyMessagePressed">
                                <TextBlock Text="{Binding CopyButtonLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Main.Text.Secondary}"
                                           VerticalAlignment="Center" />
                              </Border>
                            </StackPanel>
                          </StackPanel>
                        </Border>

                        <!-- 2) 历史消息行内编辑态（固定宽度不随内容跳变，支持文字与附件增删改 + Ctrl+V） -->
                        <Border IsVisible="{Binding IsEditing}"
                                Classes="chat-composer"
                                Padding="14,12"
                                Width="540"
                                HorizontalAlignment="Right">
                          <StackPanel Spacing="10">
                            <!-- 可编辑附件芯片行 -->
                            <ItemsControl ItemsSource="{Binding EditAttachments}" IsVisible="{Binding HasEditAttachments}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatAttachmentItem">
                                  <Panel Margin="0,0,8,6">
                                    <Border Classes="file-ref-pill" IsVisible="{Binding HasThumbnail}">
                                      <ToolTip.Tip>
                                        <StackPanel Spacing="6" MaxWidth="270">
                                          <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Main.Surface.Subtle}">
                                            <Image Source="{Binding ThumbnailBitmap}"
                                                   MaxWidth="256"
                                                   MaxHeight="180"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                          </Border>
                                          <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                      </ToolTip.Tip>
                                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" CornerRadius="4" ClipToBounds="True">
                                          <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Main.Text.Primary}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Width="18" Height="18" CornerRadius="9" Background="Transparent" Cursor="Hand" PointerPressed="OnRemoveEditAttachmentPressed">
                                          <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource Main.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                      </StackPanel>
                                    </Border>

                                    <Border Classes="file-ref-pill" IsVisible="{Binding !HasThumbnail}" ToolTip.Tip="{Binding FullPath}">
                                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border MinWidth="18" Height="18" Padding="4,0" CornerRadius="4" Background="{Binding FileBadgeBrush}" VerticalAlignment="Center">
                                          <TextBlock Text="{Binding FileBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Text.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Main.Text.Primary}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Width="18" Height="18" CornerRadius="9" Background="Transparent" Cursor="Hand" PointerPressed="OnRemoveEditAttachmentPressed">
                                          <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource Main.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                      </StackPanel>
                                    </Border>
                                  </Panel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBox Classes="bare"
                                     Text="{Binding EditText, Mode=TwoWay}"
                                     PlaceholderText="修改消息内容（支持 Ctrl+V 粘贴图片或文件）…"
                                     FontFamily="{DynamicResource Font.Ui}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="34"
                                     MaxHeight="150"
                                     FontSize="14"
                                     VerticalContentAlignment="Top"
                                     KeyDown="OnEditMessageBoxKeyDown" />

                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Border Grid.Column="0"
                                      Classes="chat-btn-ghost"
                                      Height="28"
                                      Padding="9,0"
                                      Background="{DynamicResource Main.Input}"
                                      BorderThickness="0"
                                      ToolTip.Tip="为此条消息添加图片或文档附件"
                                      PointerPressed="OnPickEditAttachmentPressed">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                  <Path Data="M6,1 V11 M1,6 H11"
                                        Stroke="{DynamicResource Main.Text.Secondary}"
                                        StrokeThickness="1.4"
                                        StrokeLineCap="Round"
                                        Width="11"
                                        Height="11"
                                        Stretch="None"
                                        VerticalAlignment="Center" />
                                  <TextBlock Text="添加附件" FontSize="11.5" Foreground="{DynamicResource Main.Text.Secondary}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Border>

                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Border Classes="chat-btn-ghost" Height="28" Padding="11,0" PointerPressed="OnCancelEditMessagePressed">
                                  <TextBlock Text="取消" FontSize="12" Foreground="{DynamicResource Main.Text.Secondary}" VerticalAlignment="Center" />
                                </Border>
                                <Border Classes="chat-btn-primary"
                                        Classes.disabled="{Binding !CanSaveEdit}"
                                        Height="28"
                                        Padding="12,0"
                                        PointerPressed="OnCommitEditMessagePressed">
                                  <TextBlock Text="保存并发送" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.OnAccent}" VerticalAlignment="Center" />
                                </Border>
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <!-- Lana 助理消息（活体 Lana 锚槽 + 历史静影 + 实时工具进度 + 纯流光思考 + Markdown 表格 + 细粒度撤销卡片） -->
                      <Grid IsVisible="{Binding IsAssistant}" ColumnDefinitions="40,*">
                        <Panel x:Name="LanaMessageSlot"
                               Grid.Column="0"
                               Width="42"
                               Height="42"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               Margin="-2,-9,0,0">
                          <c:LanaAvatarControl Width="40"
                                               Height="40"
                                               RenderMode="StaticAvatar"
                                               State="Idle"
                                               IsHitTestVisible="False"
                                               Classes="past-lana-avatar"
                                               Classes.echo="{Binding ShowPastStaticAvatar}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        </Panel>

                        <StackPanel Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Spacing="10"
                                    TextElement.FontFamily="{DynamicResource Font.Display}">

                          <!-- 交错时间序内容块：工具步骤与 Markdown（含表格/代码块/流式正文） -->
                          <ItemsControl ItemsSource="{Binding Blocks}" IsVisible="{Binding HasBlocks}">
                            <ItemsControl.DataTemplates>
                              <!-- 工具进度胶囊：执行中实时粉紫流光提示，完成后切为 ✓ 静态标签 -->
                              <DataTemplate DataType="vm:ChatToolStepViewModel">
                                <Panel svc:RevealMotion.Enabled="True"
                                       svc:RevealMotion.OffsetY="5"
                                       svc:RevealMotion.DurationMs="180"
                                       Margin="0,0,0,8">
                                  <!-- 执行中：左侧矢量转圈圆圈 + 流光进度文字（ADR-0058） -->
                                  <Border IsVisible="{Binding IsRunning}"
                                          Padding="11,6"
                                          CornerRadius="10"
                                          Background="{DynamicResource Assistant.ToolChip.Bg}"
                                          BorderBrush="{DynamicResource Main.Accent.Border}"
                                          BorderThickness="1"
                                          HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                      <vm:ToolSpinnerRing Width="13"
                                                          Height="13"
                                                          IsVisible="{Binding IsRunning}"
                                                          VerticalAlignment="Center" />
                                      <vm:LanaThinkingOrb StatusText="{Binding Label}"
                                                          TextFontSize="12"
                                                          Height="18"
                                                          VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>

                                  <!-- 已完成：同位置打钩 ✓ / 提示 ! -->
                                  <Border IsVisible="{Binding !IsRunning}"
                                          Padding="11,6"
                                          CornerRadius="10"
                                          Background="{DynamicResource Assistant.ToolChip.Bg}"
                                          BorderBrush="{DynamicResource Main.Border.Subtle}"
                                          BorderThickness="1"
                                          HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                      <Grid Width="13" Height="13" VerticalAlignment="Center">
                                        <TextBlock Text="✓"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Main.Accent}"
                                                   IsVisible="{Binding IsCompletedSuccess}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="!"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Provider.Warn.Fg}"
                                                   IsVisible="{Binding IsCompletedFailed}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                      </Grid>
                                      <TextBlock Text="{Binding Label}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource Main.Text.Secondary}"
                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                </Panel>
                              </DataTemplate>

                              <!-- Markdown 正文 / 表格 / 代码块 -->
                              <DataTemplate DataType="vm:ChatTextBlockViewModel">
                                <vm:ChatMarkdownView Source="{Binding Text}"
                                                     IsStreaming="{Binding IsStreaming}"
                                                     Margin="0,0,0,8" />
                              </DataTemplate>
                            </ItemsControl.DataTemplates>
                          </ItemsControl>

                          <!-- 纯粉紫渐变流光思考文字（无左侧圆球，多组文案轮换；就位后自左向右显现） -->
                          <vm:LanaThinkingOrb IsVisible="{Binding ShowThinkingOrb}"
                                              StatusText="{Binding ThinkingLabel}"
                                              RevealOnShow="True"
                                              Margin="2,1.5,0,2" />

                          <!-- 错误提示条 -->
                          <Border IsVisible="{Binding HasError}"
                                  svc:RevealMotion.Enabled="True"
                                  svc:RevealMotion.OffsetY="5"
                                  svc:RevealMotion.DurationMs="180"
                                  CornerRadius="10"
                                  Background="{DynamicResource Main.Danger.Soft}"
                                  Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding ErrorText}"
                                         FontSize="13"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource Main.Danger}"
                                         VerticalAlignment="Center" />
                              <Border Grid.Column="1"
                                      Margin="12,0,0,0"
                                      Padding="10,4"
                                      CornerRadius="7"
                                      Background="{DynamicResource Main.Bg}"
                                      Cursor="Hand"
                                      PointerPressed="OnRetryMessagePressed">
                                <TextBlock Text="重试" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Main.Danger}" />
                              </Border>
                            </Grid>
                          </Border>

                          <!-- 日程改动卡片（自动生效 / 待确认共用，支持单条撤销、多选撤销与全部撤销） -->
                          <Panel IsVisible="{Binding HasProposal}"
                                 svc:RevealMotion.Enabled="True"
                                 svc:RevealMotion.OffsetY="10"
                                 svc:RevealMotion.DurationMs="240"
                                 Margin="0,2,0,0">
                            <Border DataContext="{Binding Proposal}"
                                    x:DataType="vm:ChatProposalCardViewModel"
                                    CornerRadius="14"
                                    Background="{DynamicResource Assistant.AiCard.Bg}"
                                    BorderBrush="{DynamicResource Main.Divider}"
                                    BorderThickness="1"
                                    BoxShadow="{DynamicResource Main.Card.Shadow}">
                              <StackPanel>
                                <!-- 卡片顶栏 -->
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource Main.Border.Subtle}"
                                        BorderThickness="0,0,0,1">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Title}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource Main.Text.Primary}" />
                                      <TextBlock Text="{Binding Subtitle}"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource Main.Text.Tertiary}"
                                                 IsVisible="{Binding HasSubtitle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                      <Border Classes="prop-tag add" IsVisible="{Binding HasAdd}">
                                        <TextBlock Text="{Binding AddSummary}" FontSize="11" FontWeight="SemiBold" />
                                      </Border>
                                      <Border Classes="prop-tag move" IsVisible="{Binding HasMove}">
                                        <TextBlock Text="{Binding MoveSummary}" FontSize="11" FontWeight="SemiBold" />
                                      </Border>
                                      <Border Classes="prop-tag edit" IsVisible="{Binding HasEdit}">
                                        <TextBlock Text="{Binding EditSummary}" FontSize="11" FontWeight="SemiBold" />
                                      </Border>
                                      <Border Classes="prop-tag delete" IsVisible="{Binding HasDelete}">
                                        <TextBlock Text="{Binding DeleteSummary}" FontSize="11" FontWeight="SemiBold" />
                                      </Border>
                                    </StackPanel>
                                  </Grid>
                                </Border>

                                <!-- 条目列表（两行清晰排版 + 单条撤销按钮 + 多选框） -->
                                <ItemsControl ItemsSource="{Binding Items}" Margin="10,8">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChatProposalItemViewModel">
                                      <Border Classes="prop-row"
                                              Classes.dimmed="{Binding IsDimmed}"
                                              Classes.locked="{Binding IsLocked}"
                                              ToolTip.Tip="{Binding Reason}"
                                              PointerPressed="OnToggleProposalItemPressed">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                          <!-- 复选框（待确认：勾选应用；已应用：勾选多选撤销） -->
                                          <Border Grid.Column="0"
                                                  Classes="prop-check"
                                                  Classes.checked="{Binding IsCheckboxChecked}"
                                                  IsVisible="{Binding ShowCheckbox}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,10,0">
                                            <Path Data="M4,9 L7.3,12.2 L13.5,5.5"
                                                  Stroke="{DynamicResource Text.OnAccent}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Width="18"
                                                  Height="18"
                                                  Stretch="None"
                                                  IsVisible="{Binding IsCheckboxChecked}" />
                                          </Border>

                                          <!-- 动作标签 -->
                                          <Border Grid.Column="1"
                                                  Classes="prop-tag"
                                                  Classes.add="{Binding IsAdd}"
                                                  Classes.move="{Binding IsMove}"
                                                  Classes.edit="{Binding IsEdit}"
                                                  Classes.delete="{Binding IsDelete}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,1,10,0">
                                            <TextBlock Text="{Binding ActionTag}" FontSize="11" FontWeight="SemiBold" />
                                          </Border>

                                          <!-- 两行主体：标题 + 差异化圆角标签 -->
                                          <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="{Binding Title}"
                                                       Classes.undone-title="{Binding IsItemUndone}"
                                                       FontSize="13.5"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource Main.Text.Primary}"
                                                       TextWrapping="Wrap" />

                                            <WrapPanel Orientation="Horizontal">
                                              <Border Classes="prop-pill date" IsVisible="{Binding HasDateBadge}">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                  <Path Data="M2.5,4 H10.5 V10.5 H2.5 Z M2.5,6.2 H10.5 M4.8,2.5 V4.6 M8.2,2.5 V4.6"
                                                        Stroke="{DynamicResource Proposal.Pill.Date.Fg}"
                                                        StrokeThickness="1.15"
                                                        StrokeLineCap="Round"
                                                        StrokeJoin="Round"
                                                        Width="12"
                                                        Height="12"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center" />
                                                  <TextBlock Text="{Binding DateBadgeText}" FontSize="11" FontWeight="Medium" />
                                                </StackPanel>
                                              </Border>

                                              <Border Classes="prop-pill"
                                                      Classes.interactive="{Binding CanEditTaskProps}"
                                                      Classes.prio-high="{Binding IsPriorityHigh}"
                                                      Classes.prio-medium="{Binding IsPriorityMedium}"
                                                      Classes.prio-low="{Binding IsPriorityLow}"
                                                      Classes.prio-none="{Binding IsPriorityNone}"
                                                      IsVisible="{Binding ShowPriorityPill}"
                                                      ToolTip.Tip="点击直接调整优先级"
                                                      PointerPressed="OnProposalPriorityPillPressed">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                  <TextBlock Text="{Binding PriorityBadgeText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                  <Path Data="M1,1.5 L4,4.5 L7,1.5"
                                                        Stroke="{DynamicResource Main.Text.Tertiary}"
                                                        StrokeThickness="1.2"
                                                        StrokeLineCap="Round"
                                                        Stretch="None"
                                                        Width="8"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding CanEditTaskProps}" />
                                                </StackPanel>
                                              </Border>

                                              <Border Classes="prop-pill reminder"
                                                      Classes.interactive="{Binding CanEditTaskProps}"
                                                      Classes.reminder-on="{Binding HasReminder}"
                                                      IsVisible="{Binding ShowReminderPill}"
                                                      ToolTip.Tip="点击直接设置日程时刻、提前提醒与反复提醒"
                                                      PointerPressed="OnProposalReminderPillPressed">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                  <Path Data="M6.5,1.5 C4.2,1.5 2.5,3.2 2.5,5.5 V8.5 L1.3,10 H11.7 L10.5,8.5 V5.5 C10.5,3.2 8.8,1.5 6.5,1.5 Z M5.2,10.5 C5.4,11.3 5.9,11.8 6.5,11.8 C7.1,11.8 7.6,11.3 7.8,10.5"
                                                        Stroke="{DynamicResource Main.Accent}"
                                                        StrokeThickness="1.2"
                                                        StrokeLineCap="Round"
                                                        StrokeJoin="Round"
                                                        Width="11"
                                                        Height="11"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasReminder}" />
                                                  <Path Data="M6.5,1.5 C4.2,1.5 2.5,3.2 2.5,5.5 V8.5 L1.3,10 H11.7 L10.5,8.5 V5.5 C10.5,3.2 8.8,1.5 6.5,1.5 Z M5.2,10.5 C5.4,11.3 5.9,11.8 6.5,11.8 C7.1,11.8 7.6,11.3 7.8,10.5"
                                                        Stroke="{DynamicResource Main.Text.Tertiary}"
                                                        StrokeThickness="1.2"
                                                        StrokeLineCap="Round"
                                                        StrokeJoin="Round"
                                                        Width="11"
                                                        Height="11"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding !HasReminder}" />
                                                  <TextBlock Text="{Binding ReminderBadgeText}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                                  <Path Data="M1,1.5 L4,4.5 L7,1.5"
                                                        Stroke="{DynamicResource Main.Text.Tertiary}"
                                                        StrokeThickness="1.2"
                                                        StrokeLineCap="Round"
                                                        Stretch="None"
                                                        Width="8"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding CanEditTaskProps}" />
                                                </StackPanel>
                                              </Border>

                                              <Border Classes="prop-pill meta" IsVisible="{Binding HasExtraBadge}">
                                                <TextBlock Text="{Binding ExtraBadgeText}" FontSize="11" FontWeight="Medium" />
                                              </Border>

                                              <Border Classes="prop-pill meta" IsVisible="{Binding ShowFallbackSummary}">
                                                <TextBlock Text="{Binding ChangeSummary}" FontSize="11" />
                                              </Border>

                                              <Border Classes="prop-pill meta" IsVisible="{Binding IsItemUndone}">
                                                <TextBlock Text="已撤销" FontSize="11" />
                                              </Border>

                                              <Border IsVisible="{Binding HasViolation}"
                                                      Padding="7,2"
                                                      Margin="0,0,6,2"
                                                      CornerRadius="6"
                                                      Background="{DynamicResource Main.Danger.Soft}">
                                                <TextBlock Text="{Binding ViolationWarning}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Main.Danger}" />
                                              </Border>
                                            </WrapPanel>
                                          </StackPanel>

                                          <!-- 行尾单条撤销按钮（仅已应用且未撤销的条目显示） -->
                                          <Border Grid.Column="3"
                                                  Classes="item-undo-btn"
                                                  IsVisible="{Binding CanUndoSingle}"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,0,0"
                                                  ToolTip.Tip="仅撤销这一条改动"
                                                  PointerPressed="OnUndoSingleProposalItemPressed">
                                            <TextBlock Text="撤销"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource Main.Text.Secondary}"
                                                       VerticalAlignment="Center" />
                                          </Border>
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 卡片底栏：待确认 / 已生效（支持多选撤销 + 全部撤销） / 已放弃或已全部撤销 -->
                                <Border Padding="16,10"
                                        Background="{DynamicResource Main.Surface.Subtle}"
                                        CornerRadius="0,0,14,14"
                                        BorderBrush="{DynamicResource Main.Border.Subtle}"
                                        BorderThickness="0,1,0,0">
                                  <Panel>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPending}">
                                      <TextBlock Text="{Binding SelectionSummary}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource Main.Text.Secondary}"
                                                 VerticalAlignment="Center" />
                                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Border Classes="chat-btn-ghost" PointerPressed="OnDiscardProposalPressed">
                                          <TextBlock Text="放弃" FontSize="12" Foreground="{DynamicResource Main.Text.Secondary}" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Classes="chat-btn-primary"
                                                Classes.disabled="{Binding !CanApply}"
                                                PointerPressed="OnApplyProposalPressed">
                                          <TextBlock Text="确认执行"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource Text.OnAccent}"
                                                     VerticalAlignment="Center" />
                                        </Border>
                                      </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding IsApplied}"
                                          svc:RevealMotion.Enabled="True"
                                          svc:RevealMotion.OffsetY="3"
                                          svc:RevealMotion.DurationMs="150">
                                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Provider.Badge.Fg}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Provider.Badge.Fg}" VerticalAlignment="Center" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <!-- 多选撤销按钮（勾选 1 条及以上时显现） -->
                                        <Border Classes="chat-btn-soft"
                                                Height="26"
                                                Padding="10,0"
                                                CornerRadius="7"
                                                IsVisible="{Binding CanUndoSelected}"
                                                PointerPressed="OnUndoSelectedProposalItemsPressed">
                                          <TextBlock Text="{Binding UndoSelectedLabel}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Main.Accent}" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- 整批全部撤销 -->
                                        <Border Classes="chat-btn-ghost"
                                                Height="26"
                                                Padding="10,0"
                                                CornerRadius="7"
                                                PointerPressed="OnUndoProposalPressed">
                                          <TextBlock Text="全部撤销" FontSize="12" Foreground="{DynamicResource Main.Text.Secondary}" VerticalAlignment="Center" />
                                        </Border>
                                      </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Main.Text.Tertiary}">
                                      <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                          <Binding Path="IsDiscarded" />
                                          <Binding Path="IsUndone" />
                                        </MultiBinding>
                                      </TextBlock.IsVisible>
                                    </TextBlock>
                                  </Panel>
                                </Border>
                              </StackPanel>
                            </Border>
                          </Panel>

                          <!-- 回复底部的微交互操作行 -->
                          <StackPanel IsVisible="{Binding ShowActionRow}"
                                      svc:RevealMotion.Enabled="True"
                                      svc:RevealMotion.OffsetY="4"
                                      svc:RevealMotion.DurationMs="180"
                                      Orientation="Horizontal"
                                      Spacing="6"
                                      Margin="0,2,0,0">
                            <Border Classes="msg-action" PointerPressed="OnCopyMessagePressed">
                              <TextBlock Text="{Binding CopyButtonLabel}"
                                         FontSize="11"
                                         Foreground="{DynamicResource Main.Text.Tertiary}"
                                         VerticalAlignment="Center" />
                            </Border>
                            <Border Classes="msg-action" PointerPressed="OnRetryMessagePressed">
                              <TextBlock Text="重新生成"
                                         FontSize="11"
                                         Foreground="{DynamicResource Main.Text.Tertiary}"
                                         VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ModelTag}"
                                       IsVisible="{Binding HasModelTag}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Main.Text.Tertiary}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>

          <!-- C. 唯一活体 Lana 舞台层（空态居中 108×108 ↔ 首轮飞向左侧 ↔ 多轮滑落 42×42，支持全窗视线跟随鼠标） -->
          <Canvas x:Name="LivingLanaLayer" Background="{x:Null}">
            <c:LanaAvatarControl x:Name="StageLanaAvatar"
                                 IsVisible="False"
                                 Width="108"
                                 Height="108"
                                 RenderMode="Interactive"
                                 State="{Binding StageLanaState}"
                                 TrackWindowPointer="True"
                                 EnableHoverFeedback="True"
                                 AutoReturnFromHappy="True"
                                 HappyCompleted="OnStageLanaHappyCompleted"
                                 PointerWheelChanged="OnStageLanaPointerWheelChanged"
                                 Cursor="Hand" />
          </Canvas>

          <!-- D. 浮动「回到底部」胶囊（置于最上层，不被活体 Lana 遮挡） -->
          <Panel x:Name="ScrollToBottomPill"
                 IsVisible="False"
                 svc:RevealMotion.Enabled="True"
                 svc:RevealMotion.OffsetY="8"
                 svc:RevealMotion.DurationMs="160"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,12">
            <Border Classes="scroll-pill"
                    PointerPressed="OnScrollToBottomPressed">
              <TextBlock Text="↓ 回到最新消息"
                         FontSize="12"
                         Foreground="{DynamicResource Main.Text.Secondary}"
                         VerticalAlignment="Center" />
            </Border>
          </Panel>
        </Panel>

        <!-- ===== 底部浮动胶囊多行输入框 + @ 文件引用弹层 ===== -->
        <StackPanel Grid.Row="2"
                    MaxWidth="760"
                    HorizontalAlignment="Stretch"
                    Margin="28,4,28,20"
                    Spacing="8">

          <!-- @ 引用输入框内已添加图片/文件的候选浮层 -->
          <Border IsVisible="{Binding IsMentionOpen}"
                  svc:RevealMotion.Enabled="True"
                  svc:RevealMotion.OffsetY="6"
                  svc:RevealMotion.DurationMs="140"
                  MaxWidth="420"
                  HorizontalAlignment="Left"
                  CornerRadius="12"
                  Background="{DynamicResource Main.Bg}"
                  BorderBrush="{DynamicResource Main.Divider}"
                  BorderThickness="1"
                  BoxShadow="{DynamicResource Main.Popup.Shadow}"
                  Padding="6">
            <StackPanel Spacing="2">
              <TextBlock Text="引用已添加的附件"
                         FontSize="11"
                         Foreground="{DynamicResource Main.Text.Tertiary}"
                         Margin="10,4,10,4" />
              <ItemsControl ItemsSource="{Binding MentionCandidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MentionFileCandidate">
                    <Border Classes="dropdown-row"
                            Classes.selected="{Binding IsSelected}"
                            PointerPressed="OnMentionCandidatePressed">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Grid.Column="0" Margin="0,0,9,0" VerticalAlignment="Center">
                          <Border Width="22"
                                  Height="22"
                                  CornerRadius="5"
                                  ClipToBounds="True"
                                  IsVisible="{Binding HasThumbnail}">
                            <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                          </Border>
                          <Border MinWidth="22"
                                  Height="20"
                                  Padding="4,0"
                                  CornerRadius="5"
                                  Background="{Binding FileBadgeBrush}"
                                  IsVisible="{Binding !HasThumbnail}">
                            <TextBlock Text="{Binding FileBadgeText}"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                        </Panel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Main.Text.Primary}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding LocationLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Main.Text.Tertiary}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="chat-composer" Padding="16,12,12,10">
            <StackPanel Spacing="10">

              <!-- 草稿附件 / 引用文件胶囊行 -->
              <ItemsControl ItemsSource="{Binding DraftAttachments}" IsVisible="{Binding HasDraftAttachments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatAttachmentItem">
                    <Panel svc:RevealMotion.Enabled="True"
                           svc:RevealMotion.OffsetY="4"
                           svc:RevealMotion.DurationMs="150"
                           Margin="0,0,8,6">

                      <!-- 图片草稿胶囊（迷你缩略图 + 悬停大图预览） -->
                      <Border Classes="file-ref-pill" IsVisible="{Binding HasThumbnail}">
                        <ToolTip.Tip>
                          <StackPanel Spacing="6" MaxWidth="270">
                            <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Main.Surface.Subtle}">
                              <Image Source="{Binding ThumbnailBitmap}"
                                     MaxWidth="256"
                                     MaxHeight="180"
                                     Stretch="Uniform"
                                     RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                              <TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="{DynamicResource Main.Text.Tertiary}" />
                            </StackPanel>
                          </StackPanel>
                        </ToolTip.Tip>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Border Width="18" Height="18" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" />
                          </Border>
                          <TextBlock Text="{Binding Name}"
                                     FontSize="12.5"
                                     Foreground="{DynamicResource Main.Text.Primary}"
                                     MaxWidth="170"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Border Width="18"
                                  Height="18"
                                  CornerRadius="9"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  PointerPressed="OnRemoveAttachmentPressed">
                            <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource Main.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>
                      </Border>

                      <!-- 文档草稿胶囊 -->
                      <Border Classes="file-ref-pill"
                              IsVisible="{Binding !HasThumbnail}"
                              ToolTip.Tip="{Binding FullPath}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Border MinWidth="18"
                                  Height="18"
                                  Padding="4,0"
                                  CornerRadius="4"
                                  Background="{Binding FileBadgeBrush}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileBadgeText}"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding Name}"
                                     FontSize="12.5"
                                     Foreground="{DynamicResource Main.Text.Primary}"
                                     MaxWidth="170"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Border Width="18"
                                  Height="18"
                                  CornerRadius="9"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  PointerPressed="OnRemoveAttachmentPressed">
                            <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource Main.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 多行输入框 -->
              <TextBox x:Name="ComposerBox"
                       Classes="bare"
                       Text="{Binding DraftInput, Mode=TwoWay}"
                       PlaceholderText="和 Lana 聊聊日程安排…"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MaxHeight="120"
                       MinHeight="24"
                       FontSize="14"
                       VerticalContentAlignment="Top" />

              <!-- 底栏 -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        Classes="chat-btn-ghost"
                        Background="{DynamicResource Main.Input}"
                        BorderThickness="0"
                        ToolTip.Tip="添加图片或文件"
                        PointerPressed="OnPickAttachmentPressed">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Path Data="M6,1 V11 M1,6 H11"
                          Stroke="{DynamicResource Main.Text.Secondary}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          Width="12"
                          Height="12"
                          Stretch="None"
                          VerticalAlignment="Center" />
                    <TextBlock Text="添加文件 / 图片"
                               FontSize="12"
                               Foreground="{DynamicResource Main.Text.Secondary}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>

                <Panel Grid.Column="2" VerticalAlignment="Center">
                  <Border Classes="send-circle"
                          Classes.disabled="{Binding !CanSend}"
                          IsVisible="{Binding !IsGenerating}"
                          ToolTip.Tip="发送 (Enter)"
                          PointerPressed="OnSendPressed">
                    <Path Data="M8,13 V3 M3.5,7.5 L8,3 L12.5,7.5"
                          Stroke="{DynamicResource Text.OnAccent}"
                          StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Width="16"
                          Height="16"
                          Stretch="None"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                  </Border>

                  <Border Classes="stop-circle"
                          IsVisible="{Binding IsGenerating}"
                          ToolTip.Tip="停止生成"
                          PointerPressed="OnStopPressed">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="2"
                            Background="{DynamicResource Text.OnAccent}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                  </Border>
                </Panel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ===== 顶栏模型下拉菜单 ===== -->
      <Panel IsVisible="{Binding IsModelDropdownOpen}">
        <Border Background="Transparent" PointerPressed="OnDismissDropdownPressed" />
        <Border svc:RevealMotion.Enabled="True"
                svc:RevealMotion.OffsetY="6"
                svc:RevealMotion.DurationMs="150"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="52,48,0,0"
                MinWidth="268"
                MaxWidth="330"
                CornerRadius="12"
                Background="{DynamicResource Main.Bg}"
                BorderBrush="{DynamicResource Main.Divider}"
                BorderThickness="1"
                BoxShadow="{DynamicResource Main.Popup.Shadow}"
                Padding="6">
          <StackPanel Spacing="2">
            <TextBlock Text="切换模型"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Main.Text.Tertiary}"
                       Margin="10,4,10,4" />

            <ScrollViewer MaxHeight="260"
                          IsVisible="{Binding HasAvailableModels}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding AvailableModels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModelSwitcherItemViewModel">
                    <Border Classes="dropdown-row"
                            Classes.selected="{Binding IsActive}"
                            PointerPressed="OnSelectModelItemPressed">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Grid.Column="0" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                          <Image Width="20"
                                 Height="20"
                                 Stretch="Uniform"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 Source="{Binding LogoBitmap}"
                                 IsVisible="{Binding HasLogo}" />
                          <Border Width="20"
                                  Height="20"
                                  CornerRadius="6"
                                  Background="{Binding BrandBrush}"
                                  IsVisible="{Binding !HasLogo}">
                            <TextBlock Text="{Binding Monogram}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                        </Panel>

                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}"
                                     FontFamily="{DynamicResource Font.Display}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Main.Text.Primary}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Subtitle}"
                                     FontSize="11"
                                     Foreground="{DynamicResource Main.Text.Secondary}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="✓"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Main.Accent}"
                                   IsVisible="{Binding IsActive}"
                                   Margin="10,0,2,0"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="还没有已配置的模型服务"
                       IsVisible="{Binding !HasAvailableModels}"
                       FontSize="12"
                       Foreground="{DynamicResource Main.Text.Tertiary}"
                       Margin="10,8,10,8" />

            <Border Height="1" Background="{DynamicResource Main.Border.Subtle}" Margin="6,4" />

            <Border Classes="dropdown-row" PointerPressed="OnOpenModelSettingsPressed">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="⚙"
                           FontSize="13"
                           Foreground="{DynamicResource Main.Accent}"
                           VerticalAlignment="Center" />
                <TextBlock Text="管理模型服务与 API Key…"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Main.Accent}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Panel>

      <!-- ===== 卡片行内优先级 & 提醒窗内浮层（点击即生效，无需确认按钮） ===== -->
      <Border Background="Transparent"
              IsVisible="{Binding HasProposalOverlay}"
              PointerPressed="OnDismissProposalOverlayPressed" />

      <Canvas IsVisible="{Binding HasProposalOverlay}">
        <Border x:Name="ProposalPriorityOverlay"
                Width="156"
                Padding="4"
                CornerRadius="12"
                Background="{DynamicResource Main.Bg}"
                BorderBrush="{DynamicResource Main.Divider}"
                BorderThickness="1"
                BoxShadow="{DynamicResource Main.Popup.Shadow}"
                IsVisible="{Binding IsProposalPriorityMenuOpen}"
                PointerPressed="OnOverlayCardPressed">
          <StackPanel Spacing="1">
            <Border Classes="dropdown-row" PointerPressed="OnPickProposalPriorityHighPressed">
              <Grid ColumnDefinitions="18,*,Auto">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Priority.High}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="高优先级" FontSize="12.5" Foreground="{DynamicResource Main.Text.Primary}" VerticalAlignment="Center" />
                <Path Grid.Column="2" Data="M1,5.5 L4,8.5 L10,1.5" Stroke="{DynamicResource Main.Accent}" StrokeThickness="1.5" StrokeLineCap="Round" Stretch="None" Width="11" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsActiveProposalPriorityHigh}" />
              </Grid>
            </Border>
            <Border Classes="dropdown-row" PointerPressed="OnPickProposalPriorityMediumPressed">
              <Grid ColumnDefinitions="18,*,Auto">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Priority.Medium}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="中优先级" FontSize="12.5" Foreground="{DynamicResource Main.Text.Primary}" VerticalAlignment="Center" />
                <Path Grid.Column="2" Data="M1,5.5 L4,8.5 L10,1.5" Stroke="{DynamicResource Main.Accent}" StrokeThickness="1.5" StrokeLineCap="Round" Stretch="None" Width="11" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsActiveProposalPriorityMedium}" />
              </Grid>
            </Border>
            <Border Classes="dropdown-row" PointerPressed="OnPickProposalPriorityLowPressed">
              <Grid ColumnDefinitions="18,*,Auto">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Priority.Low}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="低优先级" FontSize="12.5" Foreground="{DynamicResource Main.Text.Primary}" VerticalAlignment="Center" />
                <Path Grid.Column="2" Data="M1,5.5 L4,8.5 L10,1.5" Stroke="{DynamicResource Main.Accent}" StrokeThickness="1.5" StrokeLineCap="Round" Stretch="None" Width="11" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsActiveProposalPriorityLow}" />
              </Grid>
            </Border>
            <Border Classes="dropdown-row" PointerPressed="OnPickProposalPriorityNonePressed">
              <Grid ColumnDefinitions="18,*,Auto">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Priority.None}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="无优先级" FontSize="12.5" Foreground="{DynamicResource Main.Text.Primary}" VerticalAlignment="Center" />
                <Path Grid.Column="2" Data="M1,5.5 L4,8.5 L10,1.5" Stroke="{DynamicResource Main.Accent}" StrokeThickness="1.5" StrokeLineCap="Round" Stretch="None" Width="11" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsActiveProposalPriorityNone}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <c:ReminderEditorPopover x:Name="ProposalReminderOverlay"
                                 DataContext="{Binding ProposalReminderEditor}"
                                 IsVisible="{Binding $parent[vm:AssistantPageView].((vm:AssistantPageViewModel)DataContext).IsProposalReminderEditorOpen}"
                                 PointerPressed="OnOverlayCardPressed" />
      </Canvas>

      <!-- 拖拽文件全画布柔光提示层（不挂入场动画，配合 DragOver 防抖杜绝移动闪屏） -->
      <Border IsVisible="{Binding IsDragOver}"
              Margin="16"
              CornerRadius="16"
              Background="{DynamicResource Main.Accent.Soft}"
              BorderBrush="{DynamicResource Main.Accent}"
              BorderThickness="2"
              Opacity="0.94"
              IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <c:LanaAvatarControl Width="68"
                               Height="68"
                               RenderMode="StaticAvatar"
                               State="Happy"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center" />
          <TextBlock Text="松开鼠标即可交给 Lana"
                     FontFamily="{DynamicResource Font.Display}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Main.Accent}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="支持图片、PDF、Office（Word / Excel / PPT）、HTML、ICS、EPUB、代码与文本（单文件 ≤ 20MB）"
                     FontSize="12"
                     Foreground="{DynamicResource Main.Text.Secondary}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
