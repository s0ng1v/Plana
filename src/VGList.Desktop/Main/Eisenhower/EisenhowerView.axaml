<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VGList.Desktop.Main.Eisenhower"
             xmlns:tasks="using:VGList.Desktop.Main.Tasks"
             xmlns:c="using:VGList.Desktop.Controls"
             x:Class="VGList.Desktop.Main.Eisenhower.EisenhowerView"
             x:DataType="vm:EisenhowerViewModel">

  <UserControl.Styles>
    <Style Selector="Border.q-card">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.q-card.drop-target">
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Background" Value="{DynamicResource Main.Accent.Soft}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- 象限卡片模板 -->
    <DataTemplate x:Key="QuadrantCardTemplate" x:DataType="vm:QuadrantViewModel">
      <Border Classes="surface-card q-card"
              Classes.drop-target="{Binding IsDropTarget}"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

          <!-- 顶部主题标题栏：标题色与左侧感叹号同色，右上角悬停显现 + -->
          <Border Grid.Row="0"
                  Padding="14,12,12,10"
                  BorderBrush="{DynamicResource Main.Border.Subtle}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <!-- ! 象限徽标 -->
              <Border Width="22"
                      Height="22"
                      CornerRadius="6"
                      Background="{DynamicResource Main.Eisenhower.None.Soft}"
                      IsVisible="{Binding IsNone}">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Priority.None}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <Border Width="22"
                      Height="22"
                      CornerRadius="6"
                      Background="{DynamicResource Main.Eisenhower.High.Soft}"
                      IsVisible="{Binding IsHigh}">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Priority.High}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <Border Width="22"
                      Height="22"
                      CornerRadius="6"
                      Background="{DynamicResource Main.Eisenhower.Medium.Soft}"
                      IsVisible="{Binding IsMedium}">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Priority.Medium}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <Border Width="22"
                      Height="22"
                      CornerRadius="6"
                      Background="{DynamicResource Main.Eisenhower.Low.Soft}"
                      IsVisible="{Binding IsLow}">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Priority.Low}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>

              <Panel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Priority.High}"
                           IsVisible="{Binding IsHigh}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Priority.Medium}"
                           IsVisible="{Binding IsMedium}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Priority.Low}"
                           IsVisible="{Binding IsLow}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Priority.None}"
                           IsVisible="{Binding IsNone}"
                           VerticalAlignment="Center" />
              </Panel>

              <Border Grid.Column="2"
                      Height="18"
                      MinWidth="18"
                      Padding="5,0"
                      Margin="8,0,0,0"
                      CornerRadius="9"
                      Background="{DynamicResource Main.Input}"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding PendingCount}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Main.Text.Secondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>

              <Border Grid.Column="4"
                      Classes="icon-btn q-hover-add"
                      Width="28"
                      Height="28"
                      CornerRadius="7"
                      ToolTip.Tip="在此象限新建任务"
                      PointerPressed="OnQuadrantAddPressed">
                <Path Data="M7,1.5 V12.5 M1.5,7 H12.5"
                      Stroke="{DynamicResource Main.Text.Secondary}"
                      StrokeThickness="1.5"
                      StrokeLineCap="Round"
                      Stretch="None"
                      Width="14"
                      Height="14"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>

          <!-- 卡片内独立滚动列表 -->
          <Panel Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,4,0,8">
              <StackPanel>
                <ItemsControl Classes="stretch" ItemsSource="{Binding PendingTasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tasks:MainTaskRowViewModel">
                      <c:TaskRowControl DeferSelectionUntilRelease="True"
                                        RowSelected="OnTaskRowSelected"
                                        CheckToggled="OnTaskCheckToggled"
                                        QuickRescheduleRequested="OnQuickReschedule"
                                        QuickPriorityRequested="OnQuickPriority"
                                        QuickDeleteRequested="OnQuickDelete" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="group-header"
                        Margin="8,6,8,2"
                        IsVisible="{Binding HasCompleted}"
                        PointerPressed="OnQuadrantCompletedPressed">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Classes="chevron"
                          Classes.expanded="{Binding IsCompletedExpanded}"
                          Data="M1.5,1 L5,4.5 L1.5,8"
                          Stroke="{DynamicResource Main.Text.Tertiary}"
                          StrokeThickness="1.3"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Stretch="None"
                          Width="6"
                          Height="9"
                          Margin="2,0,8,0"
                          VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="已完成"
                               FontSize="12"
                               Foreground="{DynamicResource Main.Text.Secondary}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CompletedCount}"
                               FontSize="11"
                               Foreground="{DynamicResource Main.Text.Tertiary}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <ItemsControl Classes="stretch"
                              ItemsSource="{Binding CompletedTasks}"
                              IsVisible="{Binding IsCompletedExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tasks:MainTaskRowViewModel">
                      <c:TaskRowControl DeferSelectionUntilRelease="True"
                                        RowSelected="OnTaskRowSelected"
                                        CheckToggled="OnTaskCheckToggled"
                                        QuickRescheduleRequested="OnQuickReschedule"
                                        QuickPriorityRequested="OnQuickPriority"
                                        QuickDeleteRequested="OnQuickDelete" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <TextBlock Text="暂无该象限任务"
                       FontSize="12"
                       Foreground="{DynamicResource Main.Text.Tertiary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />
          </Panel>

        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Panel x:Name="EisenhowerHost" Background="{DynamicResource Main.Surface.Subtle}">
    <Grid RowDefinitions="Auto,*">

        <!-- 头部 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,12,20,12" Height="36">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
              <Canvas Width="20" Height="20">
                <Path Data="M4.6,3.2 H7.2 A1.4,1.4 0 0 1 8.6,4.6 V7.2 A1.4,1.4 0 0 1 7.2,8.6 H4.6 A1.4,1.4 0 0 1 3.2,7.2 V4.6 A1.4,1.4 0 0 1 4.6,3.2 Z M12.8,3.2 H15.4 A1.4,1.4 0 0 1 16.8,4.6 V7.2 A1.4,1.4 0 0 1 15.4,8.6 H12.8 A1.4,1.4 0 0 1 11.4,7.2 V4.6 A1.4,1.4 0 0 1 12.8,3.2 Z M4.6,11.4 H7.2 A1.4,1.4 0 0 1 8.6,12.8 V15.4 A1.4,1.4 0 0 1 7.2,16.8 H4.6 A1.4,1.4 0 0 1 3.2,15.4 V12.8 A1.4,1.4 0 0 1 4.6,11.4 Z M12.8,11.4 H15.4 A1.4,1.4 0 0 1 16.8,12.8 V15.4 A1.4,1.4 0 0 1 15.4,16.8 H12.8 A1.4,1.4 0 0 1 11.4,15.4 V12.8 A1.4,1.4 0 0 1 12.8,11.4 Z"
                      Stroke="{DynamicResource Main.Accent}"
                      StrokeThickness="1.5"
                      StrokeJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="四象限"
                       FontFamily="{DynamicResource Font.Display}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Main.Text.Primary}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Border Grid.Column="2" Classes="segment-group" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Border Classes="segment-item" Classes.selected="{Binding IsAllScope}" PointerPressed="OnAllScopePressed">
                <TextBlock Text="全部" />
              </Border>
              <Border Classes="segment-item" Classes.selected="{Binding TodayOnly}" PointerPressed="OnTodayScopePressed">
                <TextBlock Text="仅今天" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- 2 × 2 四象限网格 -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,12,*"
              RowDefinitions="*,12,*"
              Margin="20,0,20,20">
          <ContentControl x:Name="Q1Host" Grid.Row="0" Grid.Column="0" Content="{Binding QuadrantI}" ContentTemplate="{StaticResource QuadrantCardTemplate}" />
          <ContentControl x:Name="Q2Host" Grid.Row="0" Grid.Column="2" Content="{Binding QuadrantII}" ContentTemplate="{StaticResource QuadrantCardTemplate}" />
          <ContentControl x:Name="Q3Host" Grid.Row="2" Grid.Column="0" Content="{Binding QuadrantIII}" ContentTemplate="{StaticResource QuadrantCardTemplate}" />
          <ContentControl x:Name="Q4Host" Grid.Row="2" Grid.Column="2" Content="{Binding QuadrantIV}" ContentTemplate="{StaticResource QuadrantCardTemplate}" />
        </Grid>
      </Grid>

      <!-- 点击空白收起悬浮卡 -->
      <Border Background="Transparent"
              IsVisible="{Binding IsQuickAddOpen}"
              PointerPressed="OnOverlayDismissPressed" />

      <!-- 新建 / 编辑共用悬浮卡：点击象限任务行就地弹出 -->
      <Canvas IsVisible="{Binding IsQuickAddOpen}">
        <c:TaskQuickCreateCard x:Name="QuickAddCard"
                               DataContext="{Binding QuickCreate}"
                               Submitted="OnQuickCreateSubmitted"
                               DeleteRequested="OnQuickCreateDeleteRequested"
                               Cancelled="OnQuickCreateCancelled" />
      </Canvas>

      <!-- 跨象限拖拽悬浮预览卡 -->
      <Canvas IsHitTestVisible="False">
        <Border x:Name="DragGhost"
                IsVisible="False"
                MaxWidth="260"
                Padding="12,8"
                CornerRadius="9"
                Background="{DynamicResource Main.Bg}"
                BorderBrush="{DynamicResource Main.Accent}"
                BorderThickness="1.2"
                BoxShadow="{DynamicResource Main.Popup.Shadow}"
                Opacity="0.94">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource Main.Accent}" VerticalAlignment="Center" />
            <TextBlock x:Name="DragGhostTitle"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Main.Text.Primary}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Canvas>
  </Panel>
</UserControl>
