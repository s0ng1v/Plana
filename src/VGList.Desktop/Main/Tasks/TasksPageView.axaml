<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VGList.Desktop.Main.Tasks"
             xmlns:c="using:VGList.Desktop.Controls"
             x:Class="VGList.Desktop.Main.Tasks.TasksPageView"
             x:DataType="vm:TasksPageViewModel">

  <UserControl.Styles>
    <Style Selector="Border.filter-chip">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Main.Input}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.filter-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
    </Style>
    <Style Selector="Border.filter-chip.selected">
      <Setter Property="Background" Value="{DynamicResource Main.Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent.Border}" />
    </Style>
    <Style Selector="Border.filter-chip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Main.Text.Secondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.filter-chip.selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Main.Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.trash-row">
      <Setter Property="Margin" Value="8,2" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Main.Surface.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.trash-action-btn">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource Main.Accent.Soft}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.trash-danger-btn">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource Main.Danger.Soft}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="TasksHost">
    <Grid x:Name="RootSplit">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="360" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="0.9*" MinWidth="320" />
    </Grid.ColumnDefinitions>

    <!-- ===== 左侧任务列表 ===== -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Background="{DynamicResource Main.Bg}">

      <!-- 列表头部 -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="20,12,16,0" Height="36">
        <!-- 视图图标：精致居中日历今日标（无裁切） -->
        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
          <Canvas Width="20" Height="20">
            <Path Data="M4.2,5.6 H15.8 A2,2 0 0 1 17.8,7.6 V15.5 A2,2 0 0 1 15.8,17.5 H4.2 A2,2 0 0 1 2.2,15.5 V7.6 A2,2 0 0 1 4.2,5.6 Z M2.2,9.2 H17.8 M6.8,3.2 V6.0 M13.2,3.2 V6.0"
                  Stroke="{DynamicResource Main.Accent}"
                  StrokeThickness="1.55"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
            <Ellipse Width="4.2"
                     Height="4.2"
                     Canvas.Left="7.9"
                     Canvas.Top="11.3"
                     Fill="{DynamicResource Main.Accent}" />
          </Canvas>
        </Viewbox>
        <TextBlock Grid.Column="1"
                   Text="{Binding HeaderTitle}"
                   FontFamily="{DynamicResource Font.Display}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Main.Text.Primary}"
                   Margin="9,0,0,0"
                   VerticalAlignment="Center" />
        <Border Grid.Column="2"
                Height="20"
                MinWidth="20"
                Padding="6,0"
                Margin="8,2,0,0"
                CornerRadius="10"
                Background="{DynamicResource Main.Input}"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding UnfinishedInViewCount}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Main.Text.Secondary}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- 回收站清空操作（仅在回收站非空时显示） -->
        <Panel Grid.Column="4"
               Grid.ColumnSpan="2"
               IsVisible="{Binding IsTrashSelected}"
               VerticalAlignment="Center">
          <Border Classes="trash-danger-btn"
                  Height="28"
                  IsVisible="{Binding ShowEmptyTrashButton}"
                  PointerPressed="OnBeginEmptyTrashPressed">
            <TextBlock Text="清空回收站"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Main.Danger}"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      IsVisible="{Binding IsConfirmingEmptyTrash}">
            <Border Classes="pill-btn"
                    Height="28"
                    PointerPressed="OnCancelEmptyTrashPressed">
              <TextBlock Text="取消"
                         FontSize="12"
                         Foreground="{DynamicResource Main.Text.Secondary}"
                         VerticalAlignment="Center" />
            </Border>
            <Border Height="28"
                    Padding="10,0"
                    CornerRadius="8"
                    Background="{DynamicResource Main.Danger}"
                    Cursor="Hand"
                    PointerPressed="OnConfirmEmptyTrashPressed">
              <TextBlock Text="确认清空"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Text.OnAccent}"
                         VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </Panel>

        <!-- 排序切换 -->
        <Border x:Name="SortButton"
                Grid.Column="4"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                IsVisible="{Binding IsInputVisible}"
                Classes="pill-btn"
                Height="28"
                PointerPressed="OnSortButtonPressed">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Path Data="M2,4 H12 M2,8 H9 M2,12 H6"
                  Stroke="{DynamicResource Main.Text.Secondary}"
                  StrokeThickness="1.3"
                  StrokeLineCap="Round"
                  Stretch="None"
                  Width="12"
                  Height="13"
                  VerticalAlignment="Center" />
            <TextBlock Text="{Binding SortModeLabel}"
                       FontSize="12"
                       Foreground="{DynamicResource Main.Text.Secondary}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- 快捷聚焦新建 -->
        <Border Grid.Column="5"
                Classes="icon-btn"
                IsVisible="{Binding IsInputVisible}"
                ToolTip.Tip="添加新任务 (Ctrl+N)"
                VerticalAlignment="Center"
                PointerPressed="OnAddButtonPressed">
          <Path Data="M7,1 V13 M1,7 H13"
                Stroke="{DynamicResource Main.Text.Secondary}"
                StrokeThickness="1.6"
                StrokeLineCap="Round"
                Stretch="None"
                Width="14"
                Height="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
      </Grid>

      <!-- 顶部早安轻提醒（仅今日小组件隐藏且有逾期任务时回退展示）+ 增强行内添加框 -->
      <StackPanel Grid.Row="1">
        <Border IsVisible="{Binding ShowMorningBrief}"
                Margin="16,10,16,0"
                Padding="12,7"
                CornerRadius="9"
                Background="{DynamicResource Main.Accent.Soft}"
                BorderBrush="{DynamicResource Main.Accent.Border}"
                BorderThickness="1"
                Cursor="Hand"
                PointerPressed="OnMorningBriefPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding MorningBriefText}"
                       FontSize="12.5"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Main.Accent}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    Classes="icon-btn"
                    Width="22"
                    Height="22"
                    Margin="8,0,0,0"
                    ToolTip.Tip="今日不再提示"
                    PointerPressed="OnDismissMorningBriefPressed">
              <Path Data="M3,3 L9,9 M9,3 L3,9"
                    Stroke="{DynamicResource Main.Text.Secondary}"
                    StrokeThickness="1.35"
                    StrokeLineCap="Round"
                    Width="12"
                    Height="12"
                    Stretch="None"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>

      <!-- 增强行内添加框：多行录入 + 零重挂载换行切换（彻底消除卡死） + 日期按钮 + 精简清单下拉 -->
      <Border x:Name="AddBoxBorder"
              Classes="input"
              Classes.high="{Binding IsDraftHigh}"
              Classes.medium="{Binding IsDraftMedium}"
              Classes.low="{Binding IsDraftLow}"
              Classes.none="{Binding IsDraftNone}"
              Margin="16,10,16,4"
              IsVisible="{Binding IsInputVisible}">
        <Grid x:Name="AddBoxLayout"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto"
              Margin="12,7,12,7">
          <Path x:Name="PlusIcon"
                Grid.Row="0"
                Grid.Column="0"
                Data="M7,1 V13 M1,7 H13"
                Stroke="{DynamicResource Main.Text.Tertiary}"
                StrokeThickness="1.4"
                StrokeLineCap="Round"
                Stretch="None"
                Width="12"
                Height="12"
                VerticalAlignment="Center" />

          <TextBox x:Name="AddBoxInput"
                   Grid.Row="0"
                   Grid.Column="1"
                   Margin="8,0,8,0"
                   Classes="bare"
                   Classes.high="{Binding IsDraftHigh}"
                   Classes.medium="{Binding IsDraftMedium}"
                   Classes.low="{Binding IsDraftLow}"
                   Classes.none="{Binding IsDraftNone}"
                   Classes.hint="{Binding IsDraftPriorityHint}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="22"
                   MaxHeight="132"
                   FontSize="14"
                   VerticalContentAlignment="Center"
                   Text="{Binding DraftText, Mode=TwoWay}"
                   PlaceholderText="{Binding DraftPlaceholder}" />

          <!-- 日期与清单动作区（单行时停在 Row=0 Col=2，换行时整组切到 Row=1 Col=1 Span=2，不重挂载） -->
          <StackPanel x:Name="DraftActionsPanel"
                      Grid.Row="0"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="6"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">

            <!-- 日期按钮（编辑态显现） -->
            <Border x:Name="DraftDateChip"
                    Height="24"
                    Padding="8,0"
                    Classes="draft-chip"
                    IsVisible="{Binding ShowAddOptions}"
                    ToolTip.Tip="选择目标日期"
                    PointerPressed="OnDraftDatePressed">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Path Data="M1.5,3 H12.5 M4,1 V5 M10,1 V5 M1.5,3 V11 H12.5 V3"
                      Stroke="{DynamicResource Main.Accent}"
                      StrokeThickness="1.2"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="None"
                      Width="14"
                      Height="12"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding DraftDateLabel}"
                           FontSize="11"
                           Foreground="{DynamicResource Main.Accent}"
                           VerticalAlignment="Center" />
                <Path Data="M1,1.5 L4,4.5 L7,1.5"
                      Stroke="{DynamicResource Main.Text.Tertiary}"
                      StrokeThickness="1.2"
                      StrokeLineCap="Round"
                      Stretch="None"
                      Width="8"
                      Height="6"
                      VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- 清单下拉：默认收集箱时不显示「收集箱」字样，仅显示简洁向下箭头；选中其他清单时再显示名称 -->
            <Border x:Name="DraftListButton"
                    Height="24"
                    MinWidth="24"
                    Padding="7,0"
                    Classes="draft-chip"
                    VerticalAlignment="Center"
                    ToolTip.Tip="选择目标清单"
                    PointerPressed="OnDraftListPressed">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse Width="6"
                         Height="6"
                         Fill="{Binding DraftListDotBrush}"
                         IsVisible="{Binding IsNonInboxDraftList}"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding DraftListName}"
                           FontSize="11"
                           Foreground="{DynamicResource Main.Accent}"
                           IsVisible="{Binding IsNonInboxDraftList}"
                           VerticalAlignment="Center" />
                <Path Data="M1,1.5 L4,4.5 L7,1.5"
                      Stroke="{DynamicResource Main.Text.Secondary}"
                      StrokeThickness="1.35"
                      StrokeLineCap="Round"
                      Stretch="None"
                      Width="8"
                      Height="6"
                      VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 标签与重复筛选条（有标签或已开启筛选时显现） -->
      <ScrollViewer IsVisible="{Binding HasTagFilterBar}"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    Margin="16,4,16,2">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
          <Border Classes="filter-chip"
                  Classes.selected="{Binding IsAllFilterSelected}"
                  PointerPressed="OnClearFiltersPressed">
            <TextBlock Text="全部" />
          </Border>

          <Border Classes="filter-chip"
                  Classes.selected="{Binding FilterRecurringOnly}"
                  ToolTip.Tip="只看设置了重复周期的任务"
                  PointerPressed="OnToggleRecurringFilterPressed">
            <TextBlock Text="↻ 重复任务" />
          </Border>

          <ItemsControl ItemsSource="{Binding TagFilterChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TagFilterChipViewModel">
                <Border Classes="filter-chip"
                        Classes.selected="{Binding IsSelected}"
                        Tag="{Binding Tag}"
                        PointerPressed="OnTagFilterChipPressed">
                  <TextBlock Text="{Binding Tag, StringFormat=#{0}}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      </StackPanel>

      <!-- 列表滚动区 -->
      <Panel x:Name="ListContentHost"
             Grid.Row="2"
             Background="Transparent"
             PointerPressed="OnListBackgroundPressed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,4,0,24">
          <StackPanel>

            <!-- 常规任务与已完成分组 -->
            <StackPanel IsVisible="{Binding IsNormalListVisible}">
            <ItemsControl Classes="stretch" ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MainTaskGroupViewModel">
                  <StackPanel>
                    <!-- 分组头：点击折叠，已过期带「顺延到今天」 -->
                    <Border Classes="group-header" PointerPressed="OnGroupHeaderPressed">
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <Path Classes="chevron"
                              Classes.expanded="{Binding IsExpanded}"
                              Data="M1.5,1 L5,4.5 L1.5,8"
                              Stroke="{DynamicResource Main.Text.Tertiary}"
                              StrokeThickness="1.3"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Stretch="None"
                              Width="6"
                              Height="9"
                              Margin="2,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Header}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Main.Text.Secondary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CountLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Main.Text.Tertiary}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="4"
                                Padding="8,3"
                                CornerRadius="6"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Main.Accent.Soft}"
                                IsVisible="{Binding IsOverdueGroup}"
                                ToolTip.Tip="将全部逾期任务一键顺延至今天"
                                PointerPressed="OnPostponeOverduePressed">
                          <TextBlock Text="顺延到今天"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Main.Accent}"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>

                    <ItemsControl Classes="stretch"
                                  ItemsSource="{Binding Tasks}"
                                  IsVisible="{Binding IsExpanded}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MainTaskRowViewModel">
                          <c:TaskRowControl RowSelected="OnTaskRowSelected"
                                            CheckToggled="OnTaskCheckToggled"
                                            QuickRescheduleRequested="OnQuickReschedule"
                                            QuickPriorityRequested="OnQuickPriority"
                                            QuickDeleteRequested="OnQuickDelete" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 已完成折叠分组 -->
            <Border Classes="group-header"
                    Margin="8,12,8,2"
                    IsVisible="{Binding ShowCompletedSection}"
                    PointerPressed="OnToggleCompleted">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Classes="chevron"
                      Classes.expanded="{Binding IsCompletedExpanded}"
                      Data="M1.5,1 L5,4.5 L1.5,8"
                      Stroke="{DynamicResource Main.Text.Tertiary}"
                      StrokeThickness="1.3"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="None"
                      Width="6"
                      Height="9"
                      Margin="2,0,8,0"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="已完成"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Main.Text.Secondary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding CompletedCount}"
                           FontSize="12"
                           Foreground="{DynamicResource Main.Text.Tertiary}"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>

            <ItemsControl Classes="stretch"
                          ItemsSource="{Binding CompletedTasks}"
                          IsVisible="{Binding IsCompletedExpanded}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MainTaskRowViewModel">
                  <c:TaskRowControl RowSelected="OnTaskRowSelected"
                                    CheckToggled="OnTaskCheckToggled"
                                    QuickRescheduleRequested="OnQuickReschedule"
                                    QuickPriorityRequested="OnQuickPriority"
                                    QuickDeleteRequested="OnQuickDelete" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!-- 回收站任务列表 -->
            <ItemsControl Classes="stretch"
                          ItemsSource="{Binding TrashedTasks}"
                          IsVisible="{Binding IsTrashSelected}"
                          Margin="8,4,8,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MainTaskRowViewModel">
                  <Border Classes="trash-row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Main.Text.Primary}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding ListName}"
                                     FontSize="11.5"
                                     Foreground="{DynamicResource Main.Text.Tertiary}" />
                          <TextBlock Text="{Binding DateLabel}"
                                     FontSize="11.5"
                                     Foreground="{DynamicResource Main.Text.Tertiary}" />
                          <TextBlock Text="{Binding DeletedLabel}"
                                     FontSize="11.5"
                                     Foreground="{DynamicResource Main.Text.Tertiary}" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="6"
                                  VerticalAlignment="Center">
                        <Border Classes="trash-action-btn"
                                PointerPressed="OnRestoreTrashRowPressed">
                          <TextBlock Text="恢复"
                                     FontSize="12"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource Main.Accent}"
                                     VerticalAlignment="Center" />
                        </Border>
                        <Border Classes="trash-danger-btn"
                                PointerPressed="OnPermanentlyDeleteTrashRowPressed">
                          <TextBlock Text="彻底删除"
                                     FontSize="12"
                                     Foreground="{DynamicResource Main.Danger}"
                                     VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>

        <!-- 列表空状态 -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    IsVisible="{Binding IsListEmpty}">
          <TextBlock Text="{Binding EmptyTitle}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Main.Text.Primary}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptySubtitle}"
                     FontSize="12"
                     Foreground="{DynamicResource Main.Text.Tertiary}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
    </Grid>

    <!-- 可拖拽分栏线 -->
    <GridSplitter Grid.Column="1" Classes="pane-splitter" ResizeDirection="Columns">
      <GridSplitter.Template>
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Width="1" Background="{DynamicResource Main.Divider}" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </GridSplitter.Template>
    </GridSplitter>

    <!-- ===== 右侧详情面板 ===== -->
    <Panel Grid.Column="2" Background="{DynamicResource Main.Bg}">
      <!-- 空状态与快捷键提示 -->
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  IsVisible="{Binding !HasSelection}">
        <Canvas Width="168" Height="100" HorizontalAlignment="Center">
          <Border Canvas.Left="10" Canvas.Top="24" Width="102" Height="64"
                  CornerRadius="10"
                  BorderBrush="{DynamicResource Main.Divider}"
                  BorderThickness="1.5"
                  Background="{DynamicResource Main.Bg}"
                  RenderTransform="rotate(-6deg)" />
          <Border Canvas.Left="76" Canvas.Top="10" Width="80" Height="82"
                  CornerRadius="10"
                  BorderBrush="{DynamicResource Main.Divider}"
                  BorderThickness="1.5"
                  Background="{DynamicResource Main.Bg}"
                  RenderTransform="rotate(5deg)" />
          <Border Canvas.Left="32" Canvas.Top="20" Width="104" Height="68"
                  CornerRadius="10"
                  BorderBrush="{DynamicResource Main.Divider}"
                  BorderThickness="1.5"
                  Background="{DynamicResource Main.Bg}">
            <StackPanel Margin="12,14" Spacing="8">
              <Border Height="6" Width="60" CornerRadius="3" Background="{DynamicResource Main.Accent.Soft}" HorizontalAlignment="Left" />
              <Border Height="6" Width="76" CornerRadius="3" Background="{DynamicResource Main.Divider}" HorizontalAlignment="Left" />
              <Border Height="6" Width="44" CornerRadius="3" Background="{DynamicResource Main.Divider}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </Canvas>
        <TextBlock Text="选择一条任务，查看或编辑详情"
                   FontSize="13"
                   Foreground="{DynamicResource Main.Text.Secondary}"
                   HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Border Padding="8,4" CornerRadius="6" Background="{DynamicResource Main.Input}">
            <TextBlock Text="Ctrl+N 新建" FontSize="11" Foreground="{DynamicResource Main.Text.Tertiary}" />
          </Border>
          <Border Padding="8,4" CornerRadius="6" Background="{DynamicResource Main.Input}">
            <TextBlock Text="Ctrl+B 折叠栏" FontSize="11" Foreground="{DynamicResource Main.Text.Tertiary}" />
          </Border>
          <Border Padding="8,4" CornerRadius="6" Background="{DynamicResource Main.Input}">
            <TextBlock Text="Tab 切优先级" FontSize="11" Foreground="{DynamicResource Main.Text.Tertiary}" />
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- 选中详情控件 -->
      <Border IsVisible="{Binding HasSelection}">
        <vm:TaskDetailPanel DataContext="{Binding Detail}" />
      </Border>
    </Panel>

    </Grid>

    <!-- 窗内浮层层（避免原生 Popup 矩形透明阴影） -->
    <Border Background="Transparent"
            IsVisible="{Binding HasAnyOverlay}"
            PointerPressed="OnOverlayDismissPressed" />

    <Canvas IsVisible="{Binding HasAnyOverlay}">
      <Border x:Name="SortOverlay"
              Width="156"
              Padding="4"
              CornerRadius="12"
              Background="{DynamicResource Main.Bg}"
              BorderBrush="{DynamicResource Main.Divider}"
              BorderThickness="1"
              BoxShadow="{DynamicResource Main.Popup.Shadow}"
              IsVisible="{Binding IsSortMenuOpen}"
              PointerPressed="OnOverlayCardPressed">
        <StackPanel>
          <Border Classes="menu-item" PointerPressed="OnSortDefaultPressed">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="默认排序" FontSize="13" Foreground="{DynamicResource Main.Text.Primary}" VerticalAlignment="Center" />
              <Path Grid.Column="1" Data="M1,5.5 L4,8.5 L10,1.5" Stroke="{DynamicResource Main.Accent}" StrokeThickness="1.5" StrokeLineCap="Round" Stretch="None" Width="11" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsSortDefault}" />
            </Grid>
          </Border>
          <Border Classes="menu-item" PointerPressed="OnSortPriorityPressed">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="按优先级" FontSize="13" Foreground="{DynamicResource Main.Text.Primary}" VerticalAlignment="Center" />
              <Path Grid.Column="1" Data="M1,5.5 L4,8.5 L10,1.5" Stroke="{DynamicResource Main.Accent}" StrokeThickness="1.5" StrokeLineCap="Round" Stretch="None" Width="11" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsSortPriority}" />
            </Grid>
          </Border>
          <Border Classes="menu-item" PointerPressed="OnSortDatePressed">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="按日期" FontSize="13" Foreground="{DynamicResource Main.Text.Primary}" VerticalAlignment="Center" />
              <Path Grid.Column="1" Data="M1,5.5 L4,8.5 L10,1.5" Stroke="{DynamicResource Main.Accent}" StrokeThickness="1.5" StrokeLineCap="Round" Stretch="None" Width="11" Height="9" VerticalAlignment="Center" IsVisible="{Binding IsSortDate}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="DraftListOverlay"
              Width="176"
              Padding="4"
              CornerRadius="12"
              Background="{DynamicResource Main.Bg}"
              BorderBrush="{DynamicResource Main.Divider}"
              BorderThickness="1"
              BoxShadow="{DynamicResource Main.Popup.Shadow}"
              IsVisible="{Binding IsDraftListMenuOpen}"
              PointerPressed="OnOverlayCardPressed">
        <ItemsControl ItemsSource="{Binding DraftListOptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ListPickItem">
              <Border Classes="menu-item"
                      Tag="{Binding Id}"
                      PointerPressed="OnDraftListPickPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Width="8"
                           Height="8"
                           Fill="{Binding DotBrush}"
                           VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             FontSize="13"
                             Foreground="{DynamicResource Main.Text.Primary}"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center" />
                  <Path Grid.Column="2"
                        Data="M1,5.5 L4,8.5 L10,1.5"
                        Stroke="{DynamicResource Main.Accent}"
                        StrokeThickness="1.5"
                        StrokeLineCap="Round"
                        Stretch="None"
                        Width="11"
                        Height="9"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsSelected}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <c:DatePickerPopover x:Name="DraftDateOverlay"
                           DataContext="{Binding DraftDatePicker}"
                           IsVisible="{Binding $parent[vm:TasksPageView].((vm:TasksPageViewModel)DataContext).IsDraftCalendarOpen}"
                           PointerPressed="OnOverlayCardPressed" />
    </Canvas>
  </Panel>
</UserControl>
