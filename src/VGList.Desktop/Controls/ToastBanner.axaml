<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:VGList.Desktop.Services"
             x:Class="VGList.Desktop.Controls.ToastBanner"
             x:DataType="s:ToastService"
             IsVisible="{Binding IsVisible}">

  <Border x:Name="Pill"
          Margin="24,12,24,28"
          Padding="14,9"
          CornerRadius="12"
          Background="{DynamicResource Main.Toast.Bg}"
          BorderBrush="{DynamicResource Main.Accent.Border}"
          BorderThickness="1"
          BoxShadow="{DynamicResource Main.Popup.Shadow}"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <Ellipse Width="7"
               Height="7"
               Fill="{DynamicResource Main.Accent}"
               VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}"
                 FontSize="13"
                 FontWeight="Medium"
                 Foreground="{DynamicResource Main.Toast.Text}"
                 VerticalAlignment="Center" />
      <Border Padding="9,3"
              CornerRadius="7"
              Background="{DynamicResource Main.Accent.Soft}"
              BorderBrush="{DynamicResource Main.Accent.Border}"
              BorderThickness="1"
              Cursor="Hand"
              IsVisible="{Binding HasAction}"
              PointerPressed="OnActionPressed">
        <TextBlock Text="{Binding ActionLabel}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Main.Accent}"
                   VerticalAlignment="Center" />
      </Border>
      <Border Width="22"
              Height="22"
              CornerRadius="6"
              Background="Transparent"
              Cursor="Hand"
              PointerPressed="OnDismissPressed">
        <Path Data="M2,2 L9,9 M9,2 L2,9"
              Stroke="{DynamicResource Main.Text.Tertiary}"
              StrokeThickness="1.3"
              StrokeLineCap="Round"
              Stretch="None"
              Width="11"
              Height="11"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
