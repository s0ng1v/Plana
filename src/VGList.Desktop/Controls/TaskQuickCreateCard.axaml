<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:VGList.Widgets.Support"
             x:Class="VGList.Desktop.Controls.TaskQuickCreateCard"
             x:DataType="s:QuickCreateViewModel">

  <UserControl.Styles>
    <Style Selector="Border.qc-flag-btn">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.qc-flag-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
    </Style>

    <Style Selector="Border.qc-mode-btn">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.qc-mode-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource Main.Hover}" />
    </Style>
    <Style Selector="Border.qc-mode-btn.active">
      <Setter Property="Background" Value="{DynamicResource Main.Selected}" />
    </Style>

    <Style Selector="Border.qc-subcheck">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1.4" />
      <Setter Property="BorderBrush" Value="{DynamicResource Priority.None}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.qc-subcheck.done">
      <Setter Property="Background" Value="{DynamicResource Main.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Main.Accent}" />
    </Style>
  </UserControl.Styles>

  <Border Width="348"
          CornerRadius="12"
          Background="{DynamicResource Main.Bg}"
          BorderBrush="{DynamicResource Main.Divider}"
          BorderThickness="1"
          BoxShadow="{DynamicResource Main.Popup.Shadow}"
          ClipToBounds="True"
          PointerPressed="OnCardBackgroundPressed">
    <StackPanel>

      <!-- 顶部条：编辑态含任务完成复选框 + 竖线 + 左侧日期 · 右侧优先级圆点 -->
      <Border Padding="16,12"
              BorderBrush="{DynamicResource Main.Border.Subtle}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Classes="check"
                    Classes.high="{Binding IsHigh}"
                    Classes.medium="{Binding IsMedium}"
                    Classes.low="{Binding IsLow}"
                    Classes.done="{Binding IsCompleted}"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsEditMode}"
                    PointerPressed="OnTaskCheckPressed">
              <Path Classes="checkmark"
                    Classes.shown="{Binding IsCompleted}"
                    Data="M1,5 L4.4,8.4 L11,1.6"
                    Stroke="{DynamicResource Text.OnAccent}"
                    StrokeThickness="1.6"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11"
                    Height="9" />
            </Border>

            <Border Width="1"
                    Height="15"
                    Background="{DynamicResource Main.Divider}"
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsEditMode}" />

            <Border HorizontalAlignment="Left"
                    Padding="4,2"
                    CornerRadius="6"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip.Tip="点击顺延一天"
                    PointerPressed="OnDateLabelPressed">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="M2.5,4 H13.5 M4.5,2 V5 M11.5,2 V5 M2.5,4 V13 H13.5 V4"
                      Stroke="{DynamicResource Main.Accent}"
                      StrokeThickness="1.3"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="None"
                      Width="15"
                      Height="14"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding DateDisplayLabel}"
                           FontSize="13"
                           Foreground="{DynamicResource Main.Accent}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1"
                  Classes="qc-flag-btn"
                  ToolTip.Tip="点击或按 Tab 切换优先级"
                  PointerPressed="OnPriorityFlagPressed">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Classes="priority"
                       Classes.high="{Binding IsHigh}"
                       Classes.medium="{Binding IsMedium}"
                       Classes.low="{Binding IsLow}"
                       Width="10"
                       Height="10"
                       VerticalAlignment="Center" />
              <TextBlock Text="{Binding PriorityLabel}"
                         FontSize="11"
                         Foreground="{DynamicResource Priority.High}"
                         IsVisible="{Binding IsHigh}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding PriorityLabel}"
                         FontSize="11"
                         Foreground="{DynamicResource Priority.Medium}"
                         IsVisible="{Binding IsMedium}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding PriorityLabel}"
                         FontSize="11"
                         Foreground="{DynamicResource Priority.Low}"
                         IsVisible="{Binding IsLow}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- 主输入区：标题 + 右侧待办事项按钮 + 描述 / 待办事项列表 -->
      <StackPanel Margin="16,12,16,8" Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="TitleBox"
                   Classes="bare"
                   Text="{Binding Title, Mode=TwoWay}"
                   PlaceholderText="准备做什么？"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Main.Text.Primary}"
                   Padding="0,4" />

          <Border Grid.Column="1"
                  Classes="qc-mode-btn"
                  Classes.active="{Binding IsChecklistMode}"
                  ToolTip.Tip="切换待办事项 / 多行描述"
                  VerticalAlignment="Center"
                  PointerPressed="OnToggleChecklistPressed">
            <Path Data="M3,4 H5 M8,4 H15 M3,9 H5 M8,9 H15 M3,14 H5 M8,14 H13"
                  Stroke="{DynamicResource Main.Text.Secondary}"
                  StrokeThickness="1.4"
                  StrokeLineCap="Round"
                  Stretch="None"
                  Width="17"
                  Height="17"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
        </Grid>

        <!-- 普通多行描述模式 -->
        <TextBox x:Name="DescBox"
                 Classes="bare"
                 Text="{Binding Description, Mode=TwoWay}"
                 PlaceholderText="描述"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="124"
                 MaxHeight="180"
                 FontSize="13.5"
                 Foreground="{DynamicResource Main.Text.Secondary}"
                 Padding="0,4"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 IsVisible="{Binding !IsChecklistMode}" />

        <!-- 待办事项模式（勾选 + 回车添项 + 空行 Backspace/Delete 删除） -->
        <Border IsVisible="{Binding IsChecklistMode}"
                MinHeight="124"
                Margin="0,2,0,4">
          <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SubtasksControl" Classes="stretch" ItemsSource="{Binding Subtasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:QuickSubtaskItem">
                  <Border BorderBrush="{DynamicResource Main.Border.Subtle}"
                          BorderThickness="0,0,0,1"
                          Padding="0,4">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Classes="qc-subcheck"
                              Classes.done="{Binding IsCompleted}"
                              Margin="2,0,8,0"
                              PointerPressed="OnSubtaskCheckPressed">
                        <Path Data="M1,4.5 L3.8,7.3 L9,1.5"
                              Stroke="{DynamicResource Text.OnAccent}"
                              StrokeThickness="1.4"
                              StrokeLineCap="Round"
                              Stretch="Uniform"
                              Width="9"
                              Height="8"
                              IsVisible="{Binding IsCompleted}" />
                      </Border>
                      <TextBox Grid.Column="1"
                               Classes="bare"
                               Text="{Binding Title, Mode=TwoWay}"
                               PlaceholderText="回车添加下一项"
                               FontSize="13.5"
                               Foreground="{DynamicResource Main.Text.Primary}"
                               Padding="0,2" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <!-- 底部栏：收集箱选择 + 重复规则 + 子待办饼状进度 + 新建添加 / 编辑删除 -->
      <Border Padding="16,10,16,14">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <Border Classes="pill-btn"
                  Height="28"
                  Padding="8,0"
                  Background="Transparent"
                  ToolTip.Tip="点击切换目标清单"
                  PointerPressed="OnToggleListPressed">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Data="M2.5,9.5 L4.5,3.5 H11.5 L13.5,9.5 V13.5 H2.5 Z M2.5,9.5 H5.5 L6.5,11.5 H9.5 L10.5,9.5 H13.5"
                    Stroke="{DynamicResource Main.Text.Secondary}"
                    StrokeThickness="1.25"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Stretch="None"
                    Width="15"
                    Height="15"
                    VerticalAlignment="Center" />
              <TextBlock Text="{Binding ListName}"
                         FontSize="12.5"
                         Foreground="{DynamicResource Main.Text.Primary}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="pill-btn"
                  Height="28"
                  Padding="8,0"
                  Margin="4,0,0,0"
                  Background="Transparent"
                  ToolTip.Tip="点击循环切换重复规则"
                  PointerPressed="OnCycleRecurrencePressed">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="↻"
                         FontSize="12"
                         Foreground="{DynamicResource Main.Accent}"
                         IsVisible="{Binding HasRecurrence}"
                         VerticalAlignment="Center" />
              <TextBlock Text="↻"
                         FontSize="12"
                         Foreground="{DynamicResource Main.Text.Tertiary}"
                         IsVisible="{Binding !HasRecurrence}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding RecurrenceLabel}"
                         FontSize="12"
                         Foreground="{DynamicResource Main.Accent}"
                         IsVisible="{Binding HasRecurrence}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding RecurrenceLabel}"
                         FontSize="12"
                         Foreground="{DynamicResource Main.Text.Secondary}"
                         IsVisible="{Binding !HasRecurrence}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="3"
                      Orientation="Horizontal"
                      Spacing="5"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasSubtasksProgress}">
            <s:SubtaskPieControl Width="12"
                                 Height="12"
                                 Margin="0,1,0,0"
                                 CompletedCount="{Binding SubtasksCompleted}"
                                 TotalCount="{Binding SubtasksTotal}"
                                 RingBrush="{DynamicResource Main.Text.Tertiary}"
                                 FillBrush="{DynamicResource Main.Text.Secondary}" />
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource Main.Text.Tertiary}"
                       VerticalAlignment="Center">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0}/{1}">
                  <Binding Path="SubtasksCompleted" />
                  <Binding Path="SubtasksTotal" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>

          <Border Grid.Column="4"
                  Classes="primary-btn"
                  Height="28"
                  Padding="14,0"
                  IsVisible="{Binding IsCreateMode}"
                  PointerPressed="OnSubmitPressed">
            <TextBlock Text="添加"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.OnAccent}"
                       VerticalAlignment="Center" />
          </Border>

          <Border Grid.Column="4"
                  Classes="trash-btn"
                  Width="28"
                  Height="28"
                  ToolTip.Tip="删除任务 (可撤销)"
                  IsVisible="{Binding IsEditMode}"
                  PointerPressed="OnDeletePressed">
            <Path Data="M3,5.5 H15 M6,5.5 V15 H12 V5.5 M8,5.5 V3.5 H10 V5.5"
                  StrokeThickness="1.4"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="None"
                  Width="16"
                  Height="16"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>

    </StackPanel>
  </Border>
</UserControl>
