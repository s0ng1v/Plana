<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VGList.Widgets.Today"
        x:Class="VGList.Widgets.Today.TaskDetailWindow"
        x:DataType="vm:TaskDetailViewModel"
        Title="任务详情"
        Width="440"
        Height="330"
        MinWidth="440"
        MinHeight="330"
        MaxWidth="440"
        MaxHeight="330"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{DynamicResource Font.Ui}"
        RequestedThemeVariant="Dark">

  <Window.Styles>
    <StyleInclude Source="avares://VGList.Widgets/Themes/TodayWidget.axaml" />
  </Window.Styles>

  <Border Width="440"
          Height="330"
          CornerRadius="14"
          Background="{DynamicResource Bg.Surface}"
          BorderBrush="{DynamicResource Stroke.Widget}"
          BorderThickness="1"
          ClipToBounds="True">
    <Grid RowDefinitions="48,*,46">

      <!-- 顶部：完成框 · 日期 · 优先级 -->
      <Grid Grid.Row="0"
            ColumnDefinitions="Auto,Auto,Auto,*,Auto"
            Margin="18,0"
            Background="Transparent"
            PointerPressed="OnDragAreaPressed">
        <Border Classes="check"
                Classes.done="{Binding IsCompleted}"
                VerticalAlignment="Center"
                PointerPressed="OnToggleCompleted">
          <Path Data="M1,5 L4.4,8.4 L11,1.6"
                Stroke="White"
                StrokeThickness="1.6"
                StrokeLineCap="Round"
                Stretch="Uniform"
                Width="11"
                Height="9"
                IsVisible="{Binding IsCompleted}" />
        </Border>

        <Border Grid.Column="1"
                Width="1"
                Height="16"
                Margin="12,0"
                Background="{DynamicResource Divider}"
                VerticalAlignment="Center" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Data="M2,3 H12 M4,1 V4 M10,1 V4 M2,3 V12 H12 V3"
                Stroke="{DynamicResource Accent}"
                StrokeThickness="1.3"
                StrokeLineCap="Round"
                Stretch="None"
                Width="13"
                Height="12"
                VerticalAlignment="Center" />
          <TextBlock Text="{Binding DateLabel}"
                     FontSize="14"
                     Foreground="{DynamicResource Accent}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="4"
                Classes="priority-dot"
                Classes.high="{Binding IsHigh}"
                Classes.medium="{Binding IsMedium}"
                Classes.low="{Binding IsLow}"
                Classes.none="{Binding IsNone}"
                ToolTip.Tip="{Binding PriorityLabel}"
                VerticalAlignment="Center"
                PointerPressed="OnCyclePriority">
          <Ellipse Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>

      <!-- 标题 + Markdown 内容 -->
      <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="24,0,24,0">
        <TextBox x:Name="TitleBox"
                 Classes="detail-title"
                 Text="{Binding Title, Mode=TwoWay}"
                 AcceptsReturn="False"
                 TextWrapping="NoWrap" />

        <TextBox x:Name="ContentBox"
                 Grid.Row="1"
                 Classes="detail-content"
                 Text="{Binding Content, Mode=TwoWay}"
                 PlaceholderText="添加描述…"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 TextChanged="OnContentTextChanged" />

        <Popup x:Name="SlashPopup"
               Grid.Row="1"
               PlacementTarget="{Binding #ContentBox}"
               Placement="TopEdgeAlignedLeft"
               IsLightDismissEnabled="True">
          <Border Width="196"
                  MaxHeight="292"
                  Padding="4"
                  CornerRadius="10"
                  Background="{DynamicResource Bg.Surface}"
                  BorderBrush="{DynamicResource Stroke.Widget}"
                  BorderThickness="1"
                  BoxShadow="0 8 24 0 #40000000">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding SlashItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SlashMenuItem">
                    <Border Classes="slash-item" PointerPressed="OnSlashItemPressed">
                      <Grid ColumnDefinitions="24,*">
                        <TextBlock Text="{Binding Glyph}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}"
                                   FontSize="14"
                                   Foreground="{DynamicResource Text.Primary}"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid>

      <!-- 底部：收集箱 + 占位图标 -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="18,0">
        <Border Classes="list-chip" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Data="M2,6 L4,2 H12 L14,6 M2,6 V12 H14 V6 M6,6 H10"
                  Stroke="{DynamicResource Text.Secondary}"
                  StrokeThickness="1.3"
                  StrokeLineCap="Round"
                  Stretch="None"
                  Width="13"
                  Height="11"
                  VerticalAlignment="Center" />
            <TextBlock Text="收集箱"
                       FontSize="13"
                       Foreground="{DynamicResource Text.Secondary}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Border Classes="icon-btn" Width="26" Height="26" ToolTip.Tip="文本格式">
            <TextBlock Text="Aa"
                       FontSize="14"
                       Foreground="{DynamicResource Text.Secondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <Border Classes="icon-btn" Width="26" Height="26" ToolTip.Tip="评论">
            <Path Data="M2,2 H14 V10 H7 L4,13 V10 H2 Z"
                  Stroke="{DynamicResource Text.Secondary}"
                  StrokeThickness="1.3"
                  Stretch="None"
                  Width="13"
                  Height="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <Border Classes="icon-btn" Width="26" Height="26" ToolTip.Tip="更多">
            <TextBlock Text="⋯"
                       FontSize="15"
                       Foreground="{DynamicResource Text.Secondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
